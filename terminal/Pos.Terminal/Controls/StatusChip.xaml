<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pos.Terminal.Controls.StatusChip">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource PosChipBorder}"
                    BackgroundColor="{TemplateBinding ChipColor}">
                <HorizontalStackLayout Style="{StaticResource PosChipStack}">
                    <Label Style="{StaticResource PosChipIconLabel}"
                           TextColor="{TemplateBinding TextColor}"
                           IsVisible="{TemplateBinding Icon, Converter={StaticResource NotEmptyConverter}}"
                           Text="{TemplateBinding Icon}" />
                    <Label Style="{StaticResource PosChipLabel}"
                           TextColor="{TemplateBinding TextColor}"
                           Text="{TemplateBinding Text}" />
                </HorizontalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
