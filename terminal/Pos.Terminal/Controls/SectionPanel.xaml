<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pos.Terminal.Controls.SectionPanel">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <VerticalStackLayout>
                <Label Style="{StaticResource PosSectionLabel}"
                       Text="{TemplateBinding Title}" />
                <Grid Style="{StaticResource PosPanelGrid}">
                    <ContentPresenter />
                </Grid>
            </VerticalStackLayout>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
