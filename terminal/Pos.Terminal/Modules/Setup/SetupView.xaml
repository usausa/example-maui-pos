<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Setup"
             x:Class="Pos.Terminal.Modules.Setup.SetupView"
             x:DataType="{x:Type module:SetupViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SetupViewModel}"
             shell:ShellProperty.Title="初期設定"
             shell:ShellProperty.Function1Text="{Binding CanBack, Converter={StaticResource SetupBackTextConverter}}"
             shell:ShellProperty.Function2Text="ライト"
             shell:ShellProperty.Function3Text="コード"
             shell:ShellProperty.Function4Text="登録"
             shell:ShellProperty.Function1Enabled="{Binding CanBack}"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="*,Auto,Auto">
        <!-- カメラの権限がないときも読み取り部分は黒のままにする -->
        <BoxView Grid.Row="0"
                 Color="Black" />
        <scanner:CameraView Grid.Row="0"
                            behaviors:BarcodeBind.Controller="{Binding Controller}"
                            OnDetectionFinishedCommand="{Binding DetectCommand}" />

        <!-- 読み取り枠 (QR は正方形) -->
        <Border Grid.Row="0"
                HeightRequest="220"
                WidthRequest="220"
                HorizontalOptions="Center"
                InputTransparent="True"
                Stroke="{StaticResource BlueLighten4}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="2"
                VerticalOptions="Center" />

        <!-- 読めない・登録できないときの知らせ -->
        <Label Grid.Row="1"
               Style="{StaticResource PosMessageLabel}"
               IsVisible="{Binding Message, Converter={StaticResource NotEmptyConverter}}"
               Text="{Binding Message}"
               BackgroundColor="{StaticResource BlueDarken4}"
               TextColor="White" />

        <!-- QR がないときの入力 -->
        <VerticalStackLayout Grid.Row="2"
                             Style="{StaticResource FillVerticalStack}"
                             Padding="0,0,0,16">
            <Label Style="{StaticResource PosFieldLabel}"
                   Text="サーバ URL" />
            <Entry Style="{StaticResource PosFieldEntry}"
                   behaviors:EntryBind.Controller="{Binding ApiEndPoint}"
                   Keyboard="Url"
                   Placeholder="http://server:8080/" />

            <Label Style="{StaticResource PosFieldLabel}"
                   Text="ペアリングコード" />
            <Button Style="{StaticResource PosFieldInputButton}"
                    Command="{Binding InputPairingCodeCommand}"
                    Text="{Binding PairingCode, Converter={StaticResource EmptyTextConverter}, ConverterParameter='タップして入力'}" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
