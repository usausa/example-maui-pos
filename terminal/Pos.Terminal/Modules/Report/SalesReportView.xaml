<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:models="clr-namespace:Pos.Terminal.Models"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Report"
             x:Class="Pos.Terminal.Modules.Report.SalesReportView"
             x:DataType="{x:Type module:SalesReportViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SalesReportViewModel}"
             shell:ShellProperty.Title="売上照会"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="期間"
             shell:ShellProperty.Function3Text="範囲"
             shell:ShellProperty.Function4Text="更新"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Padding="8"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Style="{StaticResource PosSelectButton}"
                    Command="{Binding PeriodCommand}"
                    Text="{Binding PeriodText}" />
            <Button Grid.Column="1"
                    Style="{StaticResource PosSelectButton}"
                    Command="{Binding ScopeCommand}"
                    Text="{Binding ScopeText}" />
            <Button Grid.Column="2"
                    Style="{StaticResource PosSelectButton}"
                    Command="{Binding GroupCommand}"
                    Text="{Binding GroupText}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource FillVerticalStack}">
                <Label Style="{StaticResource PosMessageLabel}"
                       IsVisible="{Binding Message, Converter={StaticResource NotEmptyConverter}}"
                       Text="{Binding Message}" />
                <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type models:SummarySection}">
                            <VerticalStackLayout Style="{StaticResource FillVerticalStack}">
                                <Label Style="{StaticResource PosSectionLabel}"
                                       Text="{Binding Title}" />
                                <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                                     BackgroundColor="White"
                                                     BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                            <Grid Style="{StaticResource PosListRowGrid}"
                                                  Padding="16,6"
                                                  ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource PosCaptionLabel}"
                                                       FontSize="15"
                                                       TextColor="{StaticResource PrimaryTextColor}"
                                                       Text="{Binding Label}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource PosListValueLabel}"
                                                       Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
