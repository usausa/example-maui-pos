<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Sales"
             x:Class="Pos.Terminal.Modules.Sales.ScanView"
             x:DataType="{x:Type module:ScanViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ScanViewModel}"
             shell:ShellProperty.Title="{Binding Title}"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="ライト"
             shell:ShellProperty.Function3Text="手入力"
             shell:ShellProperty.Function4Text="完了"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="*,Auto,Auto"
          BackgroundColor="Black">
        <scanner:CameraView Grid.Row="0"
                            behaviors:BarcodeBind.Controller="{Binding Controller}"
                            OnDetectionFinishedCommand="{Binding DetectCommand}" />

        <!-- 読み取り枠 -->
        <Border Grid.Row="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="260"
                HeightRequest="180"
                Stroke="{StaticResource BlueLighten4}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 8"
                InputTransparent="True" />

        <!-- 読み取り結果 -->
        <Label Grid.Row="1"
               Style="{StaticResource PosMessageLabel}"
               BackgroundColor="{StaticResource BlueDarken4}"
               TextColor="White"
               Text="{Binding Message}" />

        <Label Grid.Row="2"
               Style="{StaticResource PosCaptionLabel}"
               Padding="16,4"
               BackgroundColor="{StaticResource BlueDarken4}"
               TextColor="{StaticResource BlueLighten4}"
               HorizontalTextAlignment="Center"
               Text="{Binding Hint}" />
    </Grid>

</ContentView>
