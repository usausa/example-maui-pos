<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:markup="clr-namespace:Pos.Terminal.Markup"
             xmlns:helpers="clr-namespace:Pos.Terminal.Modules.Helpers"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Sales"
             xmlns:customer="clr-namespace:Pos.Terminal.Models.Customer"
             x:Class="Pos.Terminal.Modules.Sales.CustomerSelectView"
             x:DataType="{x:Type module:CustomerSelectViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CustomerSelectViewModel}"
             shell:ShellProperty.Title="会員選択"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="新規"
             shell:ShellProperty.Function4Text="解除"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding HasCustomer}">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              Padding="8"
              ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Style="{StaticResource PosFieldEntry}"
                   behaviors:EntryBind.Controller="{Binding Keyword}"
                   Margin="0"
                   Placeholder="会員番号 / 電話 / 名前"
                   ReturnType="Search" />
            <!-- 番号は電卓で入力する (キーボードに依存しない) -->
            <Button Grid.Column="1"
                    Style="{StaticResource PosMethodIconButton}"
                    Margin="0"
                    Command="{Binding InputNumberCommand}"
                    Text="{x:Static fonts:MaterialIcons.Dialpad}" />
            <Button Grid.Column="2"
                    Style="{StaticResource PosMethodButton}"
                    Margin="0"
                    Command="{Binding SearchCommand}"
                    Text="検索"
                    ImageSource="{x:Static markup:AppIcons.PosSearch}" />
        </Grid>

        <Label Grid.Row="1"
               Style="{StaticResource PosSectionLabel}"
               IsVisible="{Binding CurrentText, Converter={StaticResource NotEmptyConverter}}"
               Text="{Binding CurrentText}" />

        <!-- 結果。検索中と取得できないときは上に重ねて隠す -->
        <Grid Grid.Row="2">
            <!-- 検索結果 (読み込むたびに浮き上がらせる) -->
            <CollectionView Style="{StaticResource PosListCollectionView}"
                            behaviors:AnimationOption.EnterAnimation="FadeUp"
                            behaviors:AnimationOption.EnterTrigger="{Binding Items.Count}"
                            ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                        <Label Style="{StaticResource PosEmptyIconLabel}"
                               Text="👤" />
                        <Label Style="{StaticResource PosMessageLabel}"
                               Text="{Binding Message}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type customer:CustomerItem}">
                        <Grid Style="{StaticResource PosStripRowGrid}"
                              RowDefinitions="*,Auto">
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Grid Grid.Row="0"
                                  Style="{StaticResource PosAvatarRowGrid}"
                                  ColumnDefinitions="Auto,*,Auto"
                                  behaviors:TouchOption.ClickCommand="{Binding Source={RelativeSource AncestorType={x:Type module:CustomerSelectViewModel}}, Path=SelectCommand, x:DataType={x:Type module:CustomerSelectViewModel}}"
                                  behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                  behaviors:TouchOption.Ripple="True">
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource PosAvatarBorder}"
                                        BackgroundColor="{Binding Code, Converter={StaticResource AvatarColorConverter}}">
                                    <Label Style="{StaticResource PosAvatarLabel}"
                                           Text="{Binding Name, Converter={StaticResource InitialConverter}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource PosAvatarTextStack}">
                                    <Label Style="{StaticResource PosListNameLabel}"
                                           Text="{Binding Name}" />
                                    <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                        <Label Style="{StaticResource PosCodeLabel}"
                                               Text="{Binding Code}" />
                                        <Label Style="{StaticResource PosInfoLabel}"
                                               IsVisible="{Binding Phone, Converter={StaticResource NotEmptyConverter}}"
                                               Text="{Binding Phone, StringFormat='📞 {0}'}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Style="{StaticResource PosListValueLabel}"
                                       Text="{Binding PointsText}"
                                       FontAttributes="Bold" />
                            </Grid>
                            <BoxView Grid.Row="1"
                                     Style="{StaticResource PosRowSeparator}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.LoadingState}}" />
            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.OfflineState}}">
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="📡" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="{Binding Message}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>

</ContentView>
