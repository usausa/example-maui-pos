<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:markup="clr-namespace:Pos.Terminal.Markup"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Sales"
             x:Class="Pos.Terminal.Modules.Sales.ProductSearchView"
             x:DataType="{x:Type module:ProductSearchViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ProductSearchViewModel}"
             shell:ShellProperty.Title="商品検索"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="部門"
             shell:ShellProperty.Function3Text="クリア"
             shell:ShellProperty.Function4Text="—"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="False"
             behaviors:Focus.SuppressDefaultFocus="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,Auto,*">
        <!-- キーワード -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              Padding="8"
              ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Style="{StaticResource PosFieldEntry}"
                   behaviors:EntryBind.Controller="{Binding Keyword}"
                   Margin="0"
                   Placeholder="名称 / 型番 / コード"
                   ReturnType="Search" />
            <!-- 番号は電卓で入力する (キーボードに依存しない) -->
            <Button Grid.Column="1"
                    Style="{StaticResource PosMethodIconButton}"
                    Margin="0"
                    Command="{Binding InputNumberCommand}"
                    Text="{x:Static fonts:MaterialIcons.Dialpad}" />
            <Button Grid.Column="2"
                    Style="{StaticResource PosMethodButton}"
                    Margin="0"
                    Command="{Binding SearchCommand}"
                    Text="検索"
                    ImageSource="{x:Static markup:AppIcons.PosSearch}" />
        </Grid>

        <!-- 部門 (2 階層) -->
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource FillVerticalStack}"
                             IsVisible="{Binding CategoryVisible}">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,0,8,4"
                                       Spacing="6"
                                       BindableLayout.ItemsSource="{Binding Parents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type module:CategoryItem}">
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Button Style="{StaticResource PosSelectButton}"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:ProductSearchViewModel}}, Path=SelectParentCommand, x:DataType={x:Type module:ProductSearchViewModel}}"
                                    CommandParameter="{Binding .}"
                                    Text="{Binding Name}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding ChildrenVisible}">
                <HorizontalStackLayout Padding="8,0,8,4"
                                       Spacing="6"
                                       BindableLayout.ItemsSource="{Binding Children}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type module:CategoryItem}">
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Button Style="{StaticResource PosSelectButton}"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type module:ProductSearchViewModel}}, Path=SelectChildCommand, x:DataType={x:Type module:ProductSearchViewModel}}"
                                    CommandParameter="{Binding .}"
                                    Text="{Binding Name}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- 結果 (読み込むたびに浮き上がらせる) -->
        <CollectionView Grid.Row="2"
                        Style="{StaticResource PosListCollectionView}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp"
                        behaviors:AnimationOption.EnterTrigger="{Binding Items.Count}"
                        ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="🔍" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="{Binding Message}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:ProductItem}">
                    <Grid Style="{StaticResource PosStripRowGrid}"
                          RowDefinitions="*,Auto">
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <Grid Grid.Row="0"
                              Style="{StaticResource PosListRowGrid}"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto"
                              behaviors:TouchOption.ClickCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ProductSearchViewModel}}, Path=SelectCommand, x:DataType={x:Type module:ProductSearchViewModel}}"
                              behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                              behaviors:TouchOption.Ripple="True"
                              BackgroundColor="Transparent">
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                            <!-- 画像 (ないときは記号。取得できたら上に重ねる) -->
                            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                  Style="{StaticResource PosThumbnailGrid}">
                                <Label Style="{StaticResource PosThumbnailIconLabel}" />
                                <Image Style="{StaticResource PosProductImage}"
                                       Source="{Binding Image}"
                                       IsVisible="{Binding Image, Converter={StaticResource NotEmptyConverter}}" />
                            </Grid>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource PosListNameLabel}"
                                   Text="{Binding Name}" />
                            <Label Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource PosListValueLabel}"
                                   Text="{Binding PriceText}"
                                   FontAttributes="Bold" />
                            <FlexLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Style="{StaticResource PosChipFlexLayout}">
                                <Label Style="{StaticResource PosCodeLabel}"
                                       Text="{Binding Code}" />
                                <Label Style="{StaticResource PosInfoLabel}"
                                       IsVisible="{Binding Detail, Converter={StaticResource NotEmptyConverter}}"
                                       Text="{Binding Detail}" />
                                <controls:LabelChip Style="{StaticResource PosFlexLabelChip}"
                                                    IsVisible="{Binding RequiresSerial}"
                                                    Icon="{x:Static fonts:MaterialIcons.Numbers}"
                                                    Text="S/N 必須"
                                                    ChipColor="{StaticResource BlueGrayDefault}" />
                            </FlexLayout>
                        </Grid>
                        <BoxView Grid.Row="1"
                                 Style="{StaticResource PosRowSeparator}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
