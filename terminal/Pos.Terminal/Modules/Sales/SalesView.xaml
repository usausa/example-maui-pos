<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:effects="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Sales"
             x:Class="Pos.Terminal.Modules.Sales.SalesView"
             x:DataType="{x:Type module:SalesViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SalesViewModel}"
             shell:ShellProperty.Title="販売"
             shell:ShellProperty.Function1Text="メニュー"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="検索"
             shell:ShellProperty.Function4Text="会計"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding HasLines}">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*,Auto">
        <!-- 会員チップ (未設定なら「会員を選択」) -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BlueLighten5}"
              ColumnDefinitions="*,Auto">
            <effects:SfEffectsView Grid.Column="0"
                                   Style="{StaticResource PosRippleView}">
                <effects:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CustomerCommand}" />
                </effects:SfEffectsView.GestureRecognizers>
                <Label Style="{StaticResource PosListNameLabel}"
                       Padding="16,12"
                       TextColor="{StaticResource BlueDarken3}"
                       Text="{Binding CustomerText}" />
            </effects:SfEffectsView>
            <Button Grid.Column="1"
                    Style="{StaticResource PosQuantityButton}"
                    Margin="0,0,16,0"
                    FontFamily=""
                    BackgroundColor="{StaticResource GrayLighten1}"
                    IsVisible="{Binding HasCustomer}"
                    Command="{Binding ClearCustomerCommand}"
                    Text="✕" />
        </Grid>

        <!-- 明細 (タップで編集、左スワイプで削除) -->
        <CollectionView Grid.Row="1"
                        Style="{StaticResource PosListCollectionView}"
                        ItemsSource="{Binding Lines}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="🛒" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="スキャンまたは検索で商品を追加してください。" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:CartLineItem}">
                    <SwipeView>
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="削除"
                                           BackgroundColor="{StaticResource RedDefault}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type module:SalesViewModel}}, Path=DeleteLineCommand, x:DataType={x:Type module:SalesViewModel}}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <effects:SfEffectsView Style="{StaticResource PosRippleView}"
                                               BackgroundColor="White">
                            <effects:SfEffectsView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:SalesViewModel}}, Path=EditLineCommand, x:DataType={x:Type module:SalesViewModel}}"
                                                      CommandParameter="{Binding .}" />
                            </effects:SfEffectsView.GestureRecognizers>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                            <Grid Style="{StaticResource PosListRowGrid}"
                                  BackgroundColor="Transparent"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource PosListNameLabel}"
                                       Text="{Binding Name}" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource PosCaptionLabel}"
                                       Text="{Binding Detail}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource PosListValueLabel}"
                                       Text="{Binding AmountText}" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource PosCaptionLabel}"
                                       TextColor="{StaticResource RedDefault}"
                                       IsVisible="{Binding HasNote}"
                                       Text="{Binding Note}" />
                            </Grid>
                        </effects:SfEffectsView>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 小計・値引・合計 (合計は数え上げ、変わると行が光る) -->
        <Grid Grid.Row="2"
              Style="{StaticResource PosSectionRowGrid}"
              Padding="16,8"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              behaviors:AnimationOption.HighlightColor="{StaticResource YellowLighten3}"
              behaviors:AnimationOption.HighlightTrigger="{Binding TotalValue}">
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Spacing="12">
                <Label Style="{StaticResource PosCaptionLabel}"
                       Text="{Binding SubtotalText}" />
                <Label Style="{StaticResource PosCaptionLabel}"
                       TextColor="{StaticResource RedDefault}"
                       Text="{Binding DiscountText}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                   Spacing="8">
                <Label Style="{StaticResource PosNameLabel}"
                       VerticalOptions="Center"
                       FontSize="20"
                       Text="合計" />
                <Label Style="{StaticResource PosNameLabel}"
                       VerticalOptions="Center"
                       FontSize="26"
                       TextColor="{StaticResource BlueDarken2}"
                       behaviors:LabelOption.CountUpDuration="350"
                       behaviors:LabelOption.CountUpFormat="{}{0:¥#,##0}"
                       behaviors:LabelOption.CountUpValue="{Binding TotalValue}" />
            </HorizontalStackLayout>
            <Label Grid.Row="1" Grid.Column="1"
                   Style="{StaticResource PosCaptionLabel}"
                   Margin="8,0"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="End"
                   Text="{Binding TaxText}" />
            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                    Style="{StaticResource PosSelectButton}"
                    WidthRequest="48"
                    HeightRequest="48"
                    FontSize="22"
                    Command="{Binding MoreCommand}"
                    Text="⋯" />
        </Grid>
    </Grid>

</ContentView>
