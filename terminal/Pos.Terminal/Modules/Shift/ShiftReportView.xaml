<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:models="clr-namespace:Pos.Terminal.Models"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Shift"
             x:Class="Pos.Terminal.Modules.Shift.ShiftReportView"
             x:DataType="{x:Type module:ShiftReportViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ShiftReportViewModel}"
             shell:ShellProperty.Title="精算レポート"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="共有"
             shell:ShellProperty.Function3Text="印刷"
             shell:ShellProperty.Function4Text="ホーム"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                             BackgroundColor="{StaticResource GrayLighten3}">
            <Label Style="{StaticResource PosSectionLabel}"
                   Text="{Binding HeaderText}" />
            <Label Style="{StaticResource PosMessageLabel}"
                   Padding="16,0,16,8"
                   FontSize="13"
                   HorizontalTextAlignment="Start"
                   Text="{Binding SourceText}" />

            <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                 BindableLayout.ItemsSource="{Binding Sections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SummarySection}">
                        <VerticalStackLayout Style="{StaticResource FillVerticalStack}">
                            <Label Style="{StaticResource PosSectionLabel}"
                                   Text="{Binding Title}" />
                            <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                                 BackgroundColor="White"
                                                 BindableLayout.ItemsSource="{Binding Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                        <Grid Style="{StaticResource PosListRowGrid}"
                                              Padding="16,6"
                                              ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Style="{StaticResource PosCaptionLabel}"
                                                   FontSize="16"
                                                   Text="{Binding Label}" />
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource PosListValueLabel}"
                                                   Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
