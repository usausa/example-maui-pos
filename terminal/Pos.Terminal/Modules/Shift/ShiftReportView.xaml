<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Shift"
             x:Class="Pos.Terminal.Modules.Shift.ShiftReportView"
             x:DataType="{x:Type module:ShiftReportViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ShiftReportViewModel}"
             shell:ShellProperty.Title="精算レポート"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="共有"
             shell:ShellProperty.Function3Text="印刷"
             shell:ShellProperty.Function4Text="ホーム"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <ScrollView BackgroundColor="{StaticResource GrayLighten3}">
        <VerticalStackLayout Style="{StaticResource PosPanelStack}">
            <!-- 営業日と集計元 (サーバ / 端末) -->
            <Border Style="{StaticResource PosHeroBorder}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource PosListNameLabel}"
                           FontSize="18"
                           Text="{Binding HeaderText}" />
                    <Label Style="{StaticResource PosHeroCaptionLabel}"
                           Text="{Binding SourceText}" />
                </VerticalStackLayout>
            </Border>

            <!-- 現金・取引・支払方法別・税率別・部門別・ポイント -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                 BindableLayout.ItemTemplate="{StaticResource PosSectionTemplate}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
