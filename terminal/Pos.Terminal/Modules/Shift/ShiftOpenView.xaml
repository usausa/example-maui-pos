<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Shift"
             x:Class="Pos.Terminal.Modules.Shift.ShiftOpenView"
             x:DataType="{x:Type module:ShiftOpenViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ShiftOpenViewModel}"
             shell:ShellProperty.Title="レジ開設"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="—"
             shell:ShellProperty.Function3Text="—"
             shell:ShellProperty.Function4Text="開設"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="False"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource FillVerticalStack}">
            <Grid Style="{StaticResource PosValueRowGrid}"
                  ColumnDefinitions="*,Auto"
                  Padding="16,12">
                <Label Grid.Column="0"
                       Style="{StaticResource PosNameLabel}"
                       Text="📅 営業日" />
                <Label Grid.Column="1"
                       Style="{StaticResource PosValueLabel}"
                       Text="{Binding BusinessDateText}" />
            </Grid>
            <BoxView Style="{StaticResource PosSubSeparatorBoxView}" />
            <Grid Style="{StaticResource PosValueRowGrid}"
                  ColumnDefinitions="*,Auto"
                  Padding="16,12">
                <Label Grid.Column="0"
                       Style="{StaticResource PosNameLabel}"
                       Text="👤 担当" />
                <Label Grid.Column="1"
                       Style="{StaticResource PosValueLabel}"
                       Text="{Binding StaffName}" />
            </Grid>
            <BoxView Style="{StaticResource PosSubSeparatorBoxView}" />
            <Grid Style="{StaticResource PosValueRowGrid}"
                  ColumnDefinitions="*,Auto"
                  Padding="16,12">
                <Label Grid.Column="0"
                       Style="{StaticResource PosNameLabel}"
                       Text="💴 釣銭準備金" />
                <Button Grid.Column="1"
                        Style="{StaticResource PosFieldValueButton}"
                        Margin="0"
                        WidthRequest="160"
                        Command="{Binding InputCashCommand}"
                        Text="{Binding OpeningCashText}" />
            </Grid>
            <BoxView Style="{StaticResource PosSeparatorBoxView}" />
            <Label Style="{StaticResource PosMessageLabel}"
                   Text="釣銭準備金を確認して「開設」を押してください。" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
