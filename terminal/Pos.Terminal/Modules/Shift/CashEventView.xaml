<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Shift"
             x:Class="Pos.Terminal.Modules.Shift.CashEventView"
             x:DataType="{x:Type module:CashEventViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CashEventViewModel}"
             shell:ShellProperty.Title="入出金"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="—"
             shell:ShellProperty.Function3Text="—"
             shell:ShellProperty.Function4Text="確定"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="False"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource FillVerticalStack}">
            <Label Style="{StaticResource PosSectionLabel}"
                   Text="種別" />
            <Grid Style="{StaticResource MenuGrid}"
                  ColumnDefinitions="*,*,*">
                <Button Grid.Column="0"
                        Style="{StaticResource PosSelectButton}"
                        HeightRequest="56"
                        Command="{Binding SelectTypeCommand}"
                        CommandParameter="PaidIn"
                        Text="⬇ 入金">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Type}"
                                     Value="PaidIn">
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1"
                        Style="{StaticResource PosSelectButton}"
                        HeightRequest="56"
                        Command="{Binding SelectTypeCommand}"
                        CommandParameter="PaidOut"
                        Text="⬆ 出金">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Type}"
                                     Value="PaidOut">
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource PosSelectButton}"
                        HeightRequest="56"
                        Command="{Binding SelectTypeCommand}"
                        CommandParameter="NoSale"
                        Text="🗄 ドロワ開">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Type}"
                                     Value="NoSale">
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Grid Style="{StaticResource PosValueRowGrid}"
                  ColumnDefinitions="*,Auto"
                  Padding="16,12">
                <Label Grid.Column="0"
                       Style="{StaticResource PosNameLabel}"
                       Text="💴 金額" />
                <Button Grid.Column="1"
                        Style="{StaticResource PosFieldValueButton}"
                        Margin="0"
                        WidthRequest="160"
                        Command="{Binding InputAmountCommand}"
                        Text="{Binding AmountText}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Type}"
                                     Value="NoSale">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <BoxView Style="{StaticResource PosSeparatorBoxView}" />

            <Label Style="{StaticResource PosFieldLabel}"
                   Text="理由" />
            <Entry Style="{StaticResource PosFieldEntry}"
                   behaviors:EntryBind.Controller="{Binding Reason}"
                   Placeholder="両替、釣銭補充 など" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
