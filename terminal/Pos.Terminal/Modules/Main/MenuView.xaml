<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:modules="clr-namespace:Pos.Terminal.Modules"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Main"
             x:Class="Pos.Terminal.Modules.Main.MenuView"
             x:DataType="{x:Type module:MenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:MenuViewModel}"
             shell:ShellProperty.Title="ホーム"
             shell:ShellProperty.FunctionVisible="False">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto">
        <!-- シフト状態 -->
        <Grid Grid.Row="0"
              Style="{StaticResource PosListRowGrid}"
              ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Style="{StaticResource PosChipBorder}"
                    BackgroundColor="{Binding IsShiftOpen, Converter={StaticResource ShiftOpenColorConverter}}">
                <Label Style="{StaticResource PosChipLabel}"
                       Text="{Binding IsShiftOpen, Converter={StaticResource ShiftStateTextConverter}}" />
            </Border>
            <Label Grid.Column="1"
                   Style="{StaticResource PosCaptionLabel}"
                   Text="{Binding ShiftDetail}" />
        </Grid>

        <!-- 販売を最上段、設定・同期を最下段に 2 列幅で置く -->
        <Grid Grid.Row="1"
              Style="{StaticResource MenuGrid}"
              RowDefinitions="*,*,*,*,*,*,*"
              ColumnDefinitions="*,*">
            <Button Grid.Row="0" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuPrimaryButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.Sales}"
                    ImageSource="{StaticResource PosCartIcon}"
                    Text="販売" />
            <Button Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.Return}"
                    Text="↩️ 返品" />
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.TransactionList}"
                    Text="🧾 取引履歴" />
            <Button Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.ShiftOpen}"
                    Text="{Binding IsShiftOpen, Converter={StaticResource ShiftButtonTextConverter}}" />
            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.CashEvent}"
                    Text="💴 入出金" />
            <Button Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.ProductInquiry}"
                    Text="🔍 商品・在庫" />
            <Button Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.CustomerInquiry}"
                    Text="👤 会員" />
            <Button Grid.Row="4" Grid.Column="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.StockCount}"
                    Text="📦 棚卸・調整" />
            <Button Grid.Row="4" Grid.Column="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.ReceivingList}"
                    Text="📥 入荷・受領" />
            <Button Grid.Row="5" Grid.Column="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.OrderList}"
                    Text="📋 受注" />
            <Button Grid.Row="5" Grid.Column="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.SalesReport}"
                    Text="📊 売上照会" />
            <Button Grid.Row="6" Grid.ColumnSpan="2"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{x:Static modules:ViewId.Setting}"
                    Text="⚙️ 設定・同期" />
        </Grid>

        <Label Grid.Row="2"
               Style="{StaticResource FooterLabel}"
               Text="{Binding Version, StringFormat='Version {0}'}" />
    </Grid>

</ContentView>
