<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
           xmlns:module="clr-namespace:Pos.Terminal.Modules.Navigation.Modal"
           xmlns:modules="clr-namespace:Pos.Terminal.Modules"
           x:Class="Pos.Terminal.Modules.Navigation.Modal.ReasonSelectView"
           x:DataType="{x:Type module:ReasonSelectViewModel}"
           s:BindingContextResolver.Type="{x:Type module:ReasonSelectViewModel}"
           WidthRequest="{x:Static modules:ScreenSize.LargeDialogWidth}">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,Auto,Auto,Auto"
          BackgroundColor="White">
        <Label Grid.Row="0"
               Style="{StaticResource DialogTitleLabel}"
               FontSize="24"
               Text="{Binding Title}" />

        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource FillVerticalStack}"
                             BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:ReasonItem}">
                    <Grid Style="{StaticResource PosListRowGrid}"
                          Padding="16,12">
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:ReasonSelectViewModel}}, Path=SelectCommand, x:DataType={x:Type module:ReasonSelectViewModel}}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        <Label Style="{StaticResource PosListNameLabel}"
                               Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Style="{StaticResource FillVerticalStack}"
                             IsVisible="{Binding AllowCustom}">
            <Label Style="{StaticResource PosFieldLabel}"
                   Text="その他 (入力)" />
            <Entry Style="{StaticResource PosFieldEntry}"
                   Margin="16,0,16,12"
                   behaviors:EntryBind.Controller="{Binding Custom}" />
        </VerticalStackLayout>

        <Grid Grid.Row="3"
              Style="{StaticResource FunctionGrid}"
              ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource InputCancelButton}"
                    Command="{Binding CloseCommand}"
                    Text="✕" />
            <Button Grid.Column="1"
                    Style="{StaticResource InputConfirmButton}"
                    IsEnabled="{Binding AllowCustom}"
                    Command="{Binding CommitCommand}"
                    Text="✔" />
        </Grid>
    </Grid>

</mct:Popup>
