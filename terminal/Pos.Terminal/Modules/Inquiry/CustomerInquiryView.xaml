<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:effects="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:helpers="clr-namespace:Pos.Terminal.Modules.Helpers"
             xmlns:sales="clr-namespace:Pos.Terminal.Modules.Sales"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Inquiry"
             x:Class="Pos.Terminal.Modules.Inquiry.CustomerInquiryView"
             x:DataType="{x:Type module:CustomerInquiryViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CustomerInquiryViewModel}"
             shell:ShellProperty.Title="会員照会"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="検索"
             shell:ShellProperty.Function4Text="編集"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding HasCustomer}">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Padding="8"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Style="{StaticResource PosFieldEntry}"
                   Margin="0"
                   behaviors:EntryBind.Controller="{Binding Keyword}"
                   ReturnType="Search"
                   Placeholder="会員番号 / 電話 / 名前" />
            <Button Grid.Column="1"
                    Style="{StaticResource PosMethodButton}"
                    Margin="0"
                    Command="{Binding SearchCommand}"
                    ImageSource="{StaticResource PosSearchIcon}"
                    Text="検索" />
        </Grid>

        <!-- 結果と詳細。検索中と取得できないときは上に重ねて隠す -->
        <Grid Grid.Row="1">
            <!-- 検索結果 -->
            <CollectionView Style="{StaticResource PosListCollectionView}"
                            IsVisible="{Binding HasCustomer, Converter={StaticResource ReverseConverter}}"
                            behaviors:AnimationOption.EnterAnimation="FadeUp"
                            behaviors:AnimationOption.EnterTrigger="{Binding Items.Count}"
                            ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                        <Label Style="{StaticResource PosEmptyIconLabel}"
                               Text="👤" />
                        <Label Style="{StaticResource PosMessageLabel}"
                               Text="{Binding Message}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type sales:CustomerItem}">
                        <Grid Style="{StaticResource PosStripRowGrid}"
                              RowDefinitions="*,Auto">
                            <effects:SfEffectsView Grid.Row="0"
                                                   Style="{StaticResource PosRippleView}">
                                <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                <effects:SfEffectsView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:CustomerInquiryViewModel}}, Path=SelectCommand, x:DataType={x:Type module:CustomerInquiryViewModel}}"
                                                          CommandParameter="{Binding .}" />
                                </effects:SfEffectsView.GestureRecognizers>
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                <Grid Style="{StaticResource PosAvatarRowGrid}"
                                      ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Style="{StaticResource PosAvatarBorder}"
                                            BackgroundColor="{Binding Code, Converter={StaticResource AvatarColorConverter}}">
                                        <Label Style="{StaticResource PosAvatarLabel}"
                                               Text="{Binding Name, Converter={StaticResource InitialConverter}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Style="{StaticResource PosAvatarTextStack}">
                                        <Label Style="{StaticResource PosListNameLabel}"
                                               Text="{Binding Name}" />
                                        <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                            <Label Style="{StaticResource PosCodeLabel}"
                                                   Text="{Binding Code}" />
                                            <Label Style="{StaticResource PosInfoLabel}"
                                                   IsVisible="{Binding Phone, Converter={StaticResource NotEmptyConverter}}"
                                                   Text="{Binding Phone, StringFormat='📞 {0}'}" />
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Style="{StaticResource PosListValueLabel}"
                                           FontAttributes="Bold"
                                           Text="{Binding PointsText}" />
                                </Grid>
                            </effects:SfEffectsView>
                            <BoxView Grid.Row="1"
                                     Style="{StaticResource PosRowSeparator}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 詳細 -->
            <ScrollView IsVisible="{Binding HasCustomer}">
                <VerticalStackLayout Style="{StaticResource PosPanelStack}">
                    <!-- 会員とポイント残高 -->
                    <Border Style="{StaticResource PosHeroBorder}"
                            behaviors:AnimationOption.EnterAnimation="FadeUp">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Style="{StaticResource PosAvatarBorder}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    StrokeShape="RoundRectangle 24"
                                    BackgroundColor="{Binding Code, Converter={StaticResource AvatarColorConverter}}">
                                <Label Style="{StaticResource PosAvatarLabel}"
                                       FontSize="22"
                                       Text="{Binding Name, Converter={StaticResource InitialConverter}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Style="{StaticResource PosAvatarTextStack}">
                                <Label Style="{StaticResource PosListNameLabel}"
                                       FontSize="18"
                                       LineBreakMode="WordWrap"
                                       Text="{Binding Name}" />
                                <Label Style="{StaticResource PosCodeLabel}"
                                       Text="{Binding Code}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2"
                                                 VerticalOptions="Center">
                                <Label Style="{StaticResource PosHeroCaptionLabel}"
                                       HorizontalTextAlignment="End"
                                       Text="ポイント" />
                                <Label Style="{StaticResource PosHeroValueLabel}"
                                       FontSize="24"
                                       HorizontalTextAlignment="End"
                                       Text="{Binding PointsText}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- 基本情報・ポイント履歴・購入履歴 -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                         BindableLayout.ItemTemplate="{StaticResource PosSectionTemplate}" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.LoadingState}}">
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="🔍" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="検索しています。" />
                </VerticalStackLayout>
            </Grid>
            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.OfflineState}}">
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="📡" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="{Binding Message}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>

</ContentView>
