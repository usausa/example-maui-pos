<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:models="clr-namespace:Pos.Terminal.Models"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Inquiry"
             x:Class="Pos.Terminal.Modules.Inquiry.ProductInquiryView"
             x:DataType="{x:Type module:ProductInquiryViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ProductInquiryViewModel}"
             shell:ShellProperty.Title="商品・在庫照会"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="検索"
             shell:ShellProperty.Function4Text="他店在庫"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding HasProduct}">

    <Grid Style="{StaticResource PosPageGrid}">
        <!-- スキャン・検索の前 (案内) -->
        <VerticalStackLayout Style="{StaticResource PosEmptyStack}"
                             IsVisible="{Binding HasProduct, Converter={StaticResource ReverseConverter}}">
            <Label Style="{StaticResource PosEmptyIconLabel}"
                   Text="🔍" />
            <Label Style="{StaticResource PosMessageLabel}"
                   Text="{Binding Message}" />
        </VerticalStackLayout>

        <!-- 商品 -->
        <ScrollView IsVisible="{Binding HasProduct}">
            <VerticalStackLayout Style="{StaticResource FillVerticalStack}">
                <Grid Style="{StaticResource PosListRowGrid}"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource PosListNameLabel}"
                           FontSize="20"
                           LineBreakMode="WordWrap"
                           Text="{Binding Name}" />
                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource PosCaptionLabel}"
                           Text="{Binding Code}" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource PosLargeValueLabel}"
                           Text="{Binding PriceText}" />
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource PosCaptionLabel}"
                           Text="{Binding PriceDetail}" />
                </Grid>

                <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type models:SummarySection}">
                            <VerticalStackLayout Style="{StaticResource FillVerticalStack}">
                                <Label Style="{StaticResource PosSectionLabel}"
                                       Text="{Binding Title}" />
                                <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                                     BackgroundColor="White"
                                                     BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                            <Grid Style="{StaticResource PosListRowGrid}"
                                                  Padding="16,6"
                                                  ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource PosCaptionLabel}"
                                                       FontSize="15"
                                                       TextColor="{StaticResource PrimaryTextColor}"
                                                       Text="{Binding Label}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource PosListValueLabel}"
                                                       Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
