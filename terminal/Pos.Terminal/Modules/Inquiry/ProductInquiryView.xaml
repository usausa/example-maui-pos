<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:models="clr-namespace:Pos.Terminal.Models"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Inquiry"
             x:Class="Pos.Terminal.Modules.Inquiry.ProductInquiryView"
             x:DataType="{x:Type module:ProductInquiryViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ProductInquiryViewModel}"
             shell:ShellProperty.Title="商品・在庫照会"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="検索"
             shell:ShellProperty.Function4Text="他店在庫"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding HasProduct}">

    <Grid Style="{StaticResource PosPageGrid}">
        <!-- スキャン・検索の前 (案内) -->
        <VerticalStackLayout Style="{StaticResource PosEmptyStack}"
                             IsVisible="{Binding HasProduct, Converter={StaticResource ReverseConverter}}">
            <Label Style="{StaticResource PosEmptyIconLabel}"
                   Text="🔍" />
            <Label Style="{StaticResource PosMessageLabel}"
                   Text="{Binding Message}" />
        </VerticalStackLayout>

        <!-- 商品 -->
        <ScrollView IsVisible="{Binding HasProduct}">
            <VerticalStackLayout Style="{StaticResource PosPanelStack}">
                <!-- 画像 (あるときだけ。オフラインで未取得なら出さない) -->
                <Grid Style="{StaticResource PosProductImagePanelGrid}"
                      IsVisible="{Binding Image, Converter={StaticResource NotEmptyConverter}}">
                    <Image Style="{StaticResource PosProductImage}"
                           Source="{Binding Image}" />
                </Grid>

                <!-- 名称・コード・売価 -->
                <Border Style="{StaticResource PosHeroBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource PosListNameLabel}"
                               FontSize="20"
                               LineBreakMode="WordWrap"
                               Text="{Binding Name}" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource PosCodeLabel}"
                               VerticalOptions="Center"
                               Text="{Binding Code}" />
                        <Label Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                               Style="{StaticResource PosHeroValueLabel}"
                               FontSize="30"
                               VerticalOptions="Center"
                               Text="{Binding PriceText}" />
                        <Label Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource PosHeroCaptionLabel}"
                               Text="{Binding PriceDetail}" />
                    </Grid>
                </Border>

                <!-- 自店在庫・商品情報 -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                     BindableLayout.ItemTemplate="{StaticResource PosSectionTemplate}" />

                <!-- 他店在庫 (オンライン) -->
                <controls:SectionPanel Title="🌐 他店在庫"
                                       IsVisible="{Binding HasOtherStores}"
                                       behaviors:AnimationOption.EnterAnimation="FadeUp">
                    <VerticalStackLayout>
                        <!-- 取得中・取得できない・在庫なし -->
                        <Label Style="{StaticResource PosMessageLabel}"
                               IsVisible="{Binding OtherStoresMessage, Converter={StaticResource NotEmptyConverter}}"
                               Text="{Binding OtherStoresMessage}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherStores}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                    <Grid Style="{StaticResource PosPanelRowGrid}"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource PosPanelRowLabel}"
                                               Text="{Binding Label}" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource PosPanelRowValueLabel}"
                                               FontAttributes="Bold"
                                               Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </controls:SectionPanel>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
