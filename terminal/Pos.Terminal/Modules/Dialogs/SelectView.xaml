<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:module="clr-namespace:Pos.Terminal.Modules.Dialogs"
           x:Class="Pos.Terminal.Modules.Dialogs.SelectView"
           x:DataType="{x:Type module:SelectViewModel}"
           s:BindingContextResolver.Type="{x:Type module:SelectViewModel}"
           CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,Auto,Auto"
          BackgroundColor="White">
        <Label Grid.Row="0"
               Style="{StaticResource DialogTitleLabel}"
               FontSize="24"
               Text="{Binding Title}" />

        <ScrollView Grid.Row="1"
                    MaximumHeightRequest="480">
            <VerticalStackLayout Style="{StaticResource FillVerticalStack}"
                                 BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type module:SelectRow}">
                        <Grid Style="{StaticResource PosListRowGrid}"
                              Padding="16,14"
                              ColumnDefinitions="*,Auto">
                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:SelectViewModel}}, Path=SelectCommand, x:DataType={x:Type module:SelectViewModel}}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                            <Label Grid.Column="0"
                                   Style="{StaticResource PosListNameLabel}"
                                   Text="{Binding Name}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource PosListValueLabel}"
                                   IsVisible="{Binding IsSelected}"
                                   Text="✓" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              Style="{StaticResource FunctionGrid}">
            <Button Style="{StaticResource InputCancelButton}"
                    Command="{Binding CloseCommand}"
                    Text="✕" />
        </Grid>
    </Grid>

</mct:Popup>
