<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:markup="clr-namespace:Pos.Terminal.Markup"
             xmlns:models="clr-namespace:Pos.Terminal.Models"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.History"
             x:Class="Pos.Terminal.Modules.History.TransactionListView"
             x:DataType="{x:Type module:TransactionListViewModel}"
             s:BindingContextResolver.Type="{x:Type module:TransactionListViewModel}"
             shell:ShellProperty.Title="取引履歴"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="絞込"
             shell:ShellProperty.Function3Text="—"
             shell:ShellProperty.Function4Text="再送"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,Auto,Auto,*">
        <!-- シリアル番号で全店の取引を探す (オンライン)。空で検索すると端末の履歴に戻る -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="8,8,8,0"
              ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Style="{StaticResource PosFieldEntry}"
                   behaviors:EntryBind.Controller="{Binding Serial}"
                   Margin="0"
                   Placeholder="シリアル番号 (オンライン)"
                   ReturnType="Search" />
            <Button Grid.Column="1"
                    Style="{StaticResource PosMethodButton}"
                    Margin="0"
                    Command="{Binding SerialSearchCommand}"
                    Text="検索"
                    ImageSource="{x:Static markup:AppIcons.PosSearch}" />
        </Grid>

        <!-- 絞り込み (期間・種別) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,Auto"
              Padding="8"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Style="{StaticResource PosSelectButton}"
                    Command="{Binding PeriodCommand}"
                    Text="{Binding PeriodText}" />
            <Button Grid.Column="1"
                    Style="{StaticResource PosSelectButton}"
                    Command="{Binding TypeCommand}"
                    Text="{Binding TypeText}" />
            <Label Grid.Column="2"
                   Style="{StaticResource PosCaptionLabel}"
                   Text="{Binding CountText}" />
        </Grid>

        <!-- 件数の内訳 -->
        <FlexLayout Grid.Row="2"
                    Style="{StaticResource PosSummaryFlexLayout}">
            <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                 IsVisible="{Binding SaleCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter=0}"
                                 Text="{Binding SaleCount, StringFormat='販売 {0}'}"
                                 ChipColor="{StaticResource BlueDarken1}" />
            <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                 IsVisible="{Binding ReturnCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter=0}"
                                 Text="{Binding ReturnCount, StringFormat='返品 {0}'}"
                                 ChipColor="{StaticResource OrangeDarken1}" />
            <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                 IsVisible="{Binding VoidCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter=0}"
                                 Text="{Binding VoidCount, StringFormat='取消 {0}'}"
                                 ChipColor="{StaticResource RedDarken1}" />
            <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                 IsVisible="{Binding UnsentCount, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter=0}"
                                 Text="{Binding UnsentCount, StringFormat='未送信 {0}'}"
                                 ChipColor="{StaticResource BlueGrayDefault}" />
        </FlexLayout>

        <CollectionView Grid.Row="3"
                        Style="{StaticResource PosListCollectionView}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp"
                        behaviors:AnimationOption.EnterTrigger="{Binding Items.Count}"
                        ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="🧾" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="{Binding Message}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <!-- 左端の帯と行の背景で種別 (販売 / 返品 / 取消) を示す。タップで詳細、右端で明細と支払を展開 -->
                <DataTemplate x:DataType="{x:Type module:TransactionItem}">
                    <Grid Style="{StaticResource PosStripRowGrid}"
                          RowDefinitions="*,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          BackgroundColor="{Binding Type, Converter={StaticResource TransactionRowColorConverter}}">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid"
                                         Binding="{Binding IsVoided}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource RedLighten5}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <BoxView Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource PosStripBoxView}"
                                 Color="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView"
                                             Binding="{Binding IsVoided}"
                                             Value="True">
                                    <Setter Property="Color" Value="{StaticResource RedDarken1}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>

                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource PosStripBodyStack}"
                                             behaviors:TouchOption.ClickCommand="{Binding Source={RelativeSource AncestorType={x:Type module:TransactionListViewModel}}, Path=SelectCommand, x:DataType={x:Type module:TransactionListViewModel}}"
                                             behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                             behaviors:TouchOption.Ripple="True">
                            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                            <!-- レシート番号と合計 -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Style="{StaticResource PosListNameLabel}"
                                       Text="{Binding ReceiptNo}" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource PosListValueLabel}"
                                       Text="{Binding TotalText}"
                                       FontAttributes="Bold" />
                            </Grid>

                            <!-- 種別・送信状態・会員 -->
                            <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                                     Text="{Binding Type, Converter={StaticResource DisplayNameConverter}}"
                                                     ChipColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}">
                                    <controls:StatusChip.Triggers>
                                        <DataTrigger TargetType="controls:StatusChip"
                                                     Binding="{Binding IsVoided}"
                                                     Value="True">
                                            <Setter Property="ChipColor" Value="{StaticResource RedDarken1}" />
                                            <Setter Property="Text" Value="取消" />
                                        </DataTrigger>
                                    </controls:StatusChip.Triggers>
                                </controls:StatusChip>
                                <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                                     Text="{Binding SyncStatus, Converter={StaticResource DisplayNameConverter}}"
                                                     ChipColor="{Binding SyncStatus, Converter={StaticResource OutboxStatusColorConverter}}" />
                                <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                                     IsVisible="{Binding HasCustomer}"
                                                     Icon="{x:Static fonts:MaterialIcons.Person}"
                                                     Text="会員"
                                                     ChipColor="{StaticResource BlueGrayDefault}" />
                            </FlexLayout>

                            <!-- 時刻・担当・支払 -->
                            <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                <Label Style="{StaticResource PosInfoLabel}"
                                       Text="{Binding TimeText, StringFormat='🕒 {0}'}" />
                                <Label Style="{StaticResource PosInfoLabel}"
                                       Text="{Binding StaffName, StringFormat='🧑 {0}'}" />
                                <Label Style="{StaticResource PosInfoLabel}"
                                       Text="{Binding PaymentText, StringFormat='💳 {0}'}" />
                            </FlexLayout>

                            <!-- 展開: 明細と支払 -->
                            <VerticalStackLayout Style="{StaticResource PosDetailStack}"
                                                 IsVisible="{Binding IsExpanded}">
                                <BoxView Style="{StaticResource PosRowSeparator}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                            <Grid Style="{StaticResource PosDetailRowGrid}"
                                                  ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource PosDetailLabel}"
                                                       Text="{Binding Label}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource PosDetailValueLabel}"
                                                       Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <BoxView Style="{StaticResource PosRowSeparator}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                                            <Grid Style="{StaticResource PosDetailRowGrid}"
                                                  ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Style="{StaticResource PosDetailLabel}"
                                                       Text="{Binding Label, StringFormat='💳 {0}'}" />
                                                <Label Grid.Column="1"
                                                       Style="{StaticResource PosDetailValueLabel}"
                                                       Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <Button Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource PosExpandButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type module:TransactionListViewModel}}, Path=ExpandCommand, x:DataType={x:Type module:TransactionListViewModel}}"
                                CommandParameter="{Binding .}"
                                Text="{Binding IsExpanded, Converter={StaticResource ExpandGlyphConverter}}" />
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

                        <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                 Style="{StaticResource PosRowSeparator}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
