<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:helpers="clr-namespace:Pos.Terminal.Modules.Helpers"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.History"
             x:Class="Pos.Terminal.Modules.History.TransactionDetailView"
             x:DataType="{x:Type module:TransactionDetailViewModel}"
             s:BindingContextResolver.Type="{x:Type module:TransactionDetailViewModel}"
             shell:ShellProperty.Title="取引詳細"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="レシート"
             shell:ShellProperty.Function3Text="取消"
             shell:ShellProperty.Function4Text="返品"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="{Binding CanVoid}"
             shell:ShellProperty.Function4Enabled="{Binding CanReturn}">

    <ScrollView BackgroundColor="{StaticResource GrayLighten3}">
        <VerticalStackLayout Style="{StaticResource PosPanelStack}">
            <!-- レシート番号・合計・種別・送信状態 -->
            <Border Style="{StaticResource PosHeroBorder}"
                    behaviors:AnimationOption.EnterAnimation="FadeUp">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource PosListNameLabel}"
                           Text="{Binding ReceiptNo}"
                           FontSize="18" />
                    <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                           Style="{StaticResource PosHeroValueLabel}"
                           VerticalOptions="Center"
                           Text="{Binding TotalText}"
                           FontSize="28" />
                    <FlexLayout Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource PosChipFlexLayout}">
                        <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                             Text="{Binding Type, Converter={StaticResource DisplayNameConverter}}"
                                             ChipColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}">
                            <controls:StatusChip.Triggers>
                                <DataTrigger TargetType="controls:StatusChip"
                                             Binding="{Binding IsVoided}"
                                             Value="True">
                                    <Setter Property="ChipColor" Value="{StaticResource RedDarken1}" />
                                    <Setter Property="Text" Value="{x:Static helpers:ViewHelper.VoidedText}" />
                                </DataTrigger>
                            </controls:StatusChip.Triggers>
                        </controls:StatusChip>
                        <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                             Text="{Binding SyncStatus, Converter={StaticResource DisplayNameConverter}}"
                                             ChipColor="{Binding SyncStatus, Converter={StaticResource OutboxStatusColorConverter}}" />
                    </FlexLayout>
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource PosHeroCaptionLabel}"
                           Text="{Binding HeaderDetail}"
                           LineBreakMode="WordWrap" />
                </Grid>
            </Border>

            <!-- 明細・金額・支払・ポイント・配送 -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                 BindableLayout.ItemTemplate="{StaticResource PosSectionTemplate}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
