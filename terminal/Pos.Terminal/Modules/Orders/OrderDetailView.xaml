<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:helpers="clr-namespace:Pos.Terminal.Modules.Helpers"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Orders"
             x:Class="Pos.Terminal.Modules.Orders.OrderDetailView"
             x:DataType="{x:Type module:OrderDetailViewModel}"
             s:BindingContextResolver.Type="{x:Type module:OrderDetailViewModel}"
             shell:ShellProperty.Title="受注詳細"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="入荷"
             shell:ShellProperty.Function3Text="操作"
             shell:ShellProperty.Function4Text="会計へ"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="{Binding CanArrive}"
             shell:ShellProperty.Function3Enabled="{Binding CanOperate}"
             shell:ShellProperty.Function4Enabled="{Binding CanCheckout}">

    <!-- 取得中は空の面で隠し、取得できないときは理由を重ねる -->
    <Grid>
        <ScrollView BackgroundColor="{StaticResource GrayLighten3}">
            <VerticalStackLayout Style="{StaticResource PosPanelStack}">
                <!-- お客様・金額・状態・種別・受注番号 -->
                <Border Style="{StaticResource PosHeroBorder}"
                        behaviors:AnimationOption.EnterAnimation="FadeUp"
                        behaviors:AnimationOption.EnterTrigger="{Binding OrderNo}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource PosListNameLabel}"
                               Text="{Binding CustomerName}"
                               FontSize="18"
                               LineBreakMode="WordWrap" />
                        <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                               Style="{StaticResource PosHeroValueLabel}"
                               VerticalOptions="Center"
                               Text="{Binding TotalText}"
                               FontSize="28" />
                        <FlexLayout Grid.Row="1" Grid.Column="0"
                                    Style="{StaticResource PosChipFlexLayout}">
                            <controls:LabelChip Style="{StaticResource PosFlexLabelChip}"
                                                Text="{Binding Status, Converter={StaticResource DisplayNameConverter}}"
                                                ChipColor="{Binding Status, Converter={StaticResource OrderStatusColorConverter}}" />
                            <controls:LabelChip Style="{StaticResource PosFlexLabelChip}"
                                                Text="{Binding Type, Converter={StaticResource DisplayNameConverter}}"
                                                ChipColor="{Binding Type, Converter={StaticResource OrderTypeColorConverter}}" />
                            <Label Style="{StaticResource PosCodeLabel}"
                                   Text="{Binding OrderNo}" />
                        </FlexLayout>
                        <Label Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource PosCaptionLabel}"
                               HorizontalOptions="End"
                               IsVisible="{Binding HasDeposit}"
                               Text="{Binding DepositText}" />
                    </Grid>
                </Border>

                <!-- お客様・明細・前受金・経過 -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}"
                                     BindableLayout.ItemTemplate="{StaticResource PosSectionTemplate}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Style="{StaticResource PosPageGrid}"
              IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.LoadingState}}" />
        <Grid Style="{StaticResource PosPageGrid}"
              IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.OfflineState}}">
            <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                <Label Style="{StaticResource PosEmptyIconLabel}"
                       Text="📡" />
                <Label Style="{StaticResource PosMessageLabel}"
                       Text="取得できません" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentView>
