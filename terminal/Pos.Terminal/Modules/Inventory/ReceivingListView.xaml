<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:helpers="clr-namespace:Pos.Terminal.Modules.Helpers"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Inventory"
             x:Class="Pos.Terminal.Modules.Inventory.ReceivingListView"
             x:DataType="{x:Type module:ReceivingListViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ReceivingListViewModel}"
             shell:ShellProperty.Title="入荷・受領"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="—"
             shell:ShellProperty.Function3Text="—"
             shell:ShellProperty.Function4Text="更新"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="False"
             shell:ShellProperty.Function3Enabled="False"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,*">
        <!-- 件数 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="16,8"
              ColumnSpacing="8">
            <Label Grid.Column="1"
                   Style="{StaticResource PosCaptionLabel}"
                   Text="{Binding CountText}" />
        </Grid>

        <!-- 結果。取得中と取得できないときは上に重ねて隠す -->
        <Grid Grid.Row="1">
            <CollectionView Style="{StaticResource PosListCollectionView}"
                            behaviors:AnimationOption.EnterAnimation="FadeUp"
                            behaviors:AnimationOption.EnterTrigger="{Binding Items.Count}"
                            ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                        <Label Style="{StaticResource PosEmptyIconLabel}"
                               Text="📥" />
                        <Label Style="{StaticResource PosMessageLabel}"
                               Text="{Binding Message}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <!-- 左端の帯で種類 (入荷 / 移動) を示す。タップで検品 -->
                    <DataTemplate x:DataType="{x:Type module:ReceivingItem}">
                        <Grid Style="{StaticResource PosStripRowGrid}"
                              RowDefinitions="*,Auto"
                              ColumnDefinitions="Auto,*"
                              BackgroundColor="White">
                            <BoxView Grid.Row="0" Grid.Column="0"
                                     Style="{StaticResource PosStripBoxView}"
                                     Color="{Binding Kind, Converter={StaticResource ReceivingKindColorConverter}}" />

                            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                            <!-- 右端に操作の列がないので右の余白を足す -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource PosStripBodyStack}"
                                                 behaviors:TouchOption.ClickCommand="{Binding Source={RelativeSource AncestorType={x:Type module:ReceivingListViewModel}}, Path=SelectCommand, x:DataType={x:Type module:ReceivingListViewModel}}"
                                                 behaviors:TouchOption.ClickCommandParameter="{Binding .}"
                                                 behaviors:TouchOption.Ripple="True"
                                                 Padding="12,8,16,8">
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                <!-- 仕入先か出荷店と、入荷予定日か出荷日時 -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PosListNameLabel}"
                                           Text="{Binding Source}" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource PosCaptionLabel}"
                                           Text="{Binding DateText}" />
                                </Grid>

                                <!-- 種類と番号 -->
                                <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                    <controls:LabelChip Style="{StaticResource PosFlexLabelChip}"
                                                        Text="{Binding Kind, Converter={StaticResource DisplayNameConverter}}"
                                                        ChipColor="{Binding Kind, Converter={StaticResource ReceivingKindColorConverter}}" />
                                    <Label Style="{StaticResource PosCodeLabel}"
                                           Text="{Binding Number}" />
                                </FlexLayout>

                                <Label Style="{StaticResource PosCaptionLabel}"
                                       Text="{Binding Summary}" />
                            </VerticalStackLayout>

                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Style="{StaticResource PosRowSeparator}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.LoadingState}}" />
            <Grid Style="{StaticResource PosPageGrid}"
                  IsVisible="{Binding CurrentState, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:ViewHelper.OfflineState}}">
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="📡" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="{Binding Message}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>

</ContentView>
