<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Pos.Terminal.Shell"
             xmlns:controls="clr-namespace:Pos.Terminal.Controls"
             xmlns:module="clr-namespace:Pos.Terminal.Modules.Inventory"
             x:Class="Pos.Terminal.Modules.Inventory.StockCountView"
             x:DataType="{x:Type module:StockCountViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StockCountViewModel}"
             shell:ShellProperty.Title="{Binding IsAdjustment, Converter={StaticResource StockTitleConverter}}"
             shell:ShellProperty.Function1Text="戻る"
             shell:ShellProperty.Function2Text="スキャン"
             shell:ShellProperty.Function3Text="モード"
             shell:ShellProperty.Function4Text="{Binding Items.Count, Converter={StaticResource StockSendTextConverter}}"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="{Binding Items.Count, Converter={StaticResource GreaterThanToBoolConverter}, ConverterParameter=0}">

    <Grid Style="{StaticResource PosPageGrid}"
          RowDefinitions="Auto,Auto,*">
        <Button Grid.Row="0"
                Style="{StaticResource PosMethodButton}"
                Margin="8"
                Command="{Binding InputCodeCommand}"
                ImageSource="{StaticResource PosDialpadIcon}"
                Text="JAN / 商品コードを入力" />

        <Label Grid.Row="1"
               Style="{StaticResource PosMessageLabel}"
               Padding="16,0,16,8"
               FontSize="14"
               Text="{Binding IsAdjustment, Converter={StaticResource StockModeTextConverter}}" />

        <CollectionView Grid.Row="2"
                        Style="{StaticResource PosListCollectionView}"
                        ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{StaticResource PosEmptyStack}">
                    <Label Style="{StaticResource PosEmptyIconLabel}"
                           Text="📦" />
                    <Label Style="{StaticResource PosMessageLabel}"
                           Text="商品をスキャンして数量を入力してください。" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:StockChangeItem}">
                    <SwipeView>
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="削除"
                                           BackgroundColor="{StaticResource RedDefault}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type module:StockCountViewModel}}, Path=RemoveCommand, x:DataType={x:Type module:StockCountViewModel}}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        <!-- 左端の帯で種別 (棚卸 / 調整) を示す -->
                        <Grid Style="{StaticResource PosStripRowGrid}"
                              RowDefinitions="*,Auto"
                              ColumnDefinitions="Auto,*"
                              BackgroundColor="White">
                            <BoxView Grid.Row="0" Grid.Column="0"
                                     Style="{StaticResource PosStripBoxView}"
                                     Color="{Binding Change.Type, Converter={StaticResource StockTypeColorConverter}}" />
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource PosStripBodyStack}"
                                                 Padding="12,10,16,10">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PosListNameLabel}"
                                           Text="{Binding Name}" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource PosListValueLabel}"
                                           FontAttributes="Bold"
                                           Text="{Binding QuantityText}" />
                                </Grid>
                                <FlexLayout Style="{StaticResource PosChipFlexLayout}">
                                    <controls:StatusChip Style="{StaticResource PosFlexStatusChip}"
                                                         ChipColor="{Binding Change.Type, Converter={StaticResource StockTypeColorConverter}}"
                                                         Icon="{Binding Change.Type, Converter={StaticResource StockTypeIconConverter}}"
                                                         Text="{Binding Change.Type, Converter={StaticResource StockTypeTextConverter}}" />
                                    <Label Style="{StaticResource PosCodeLabel}"
                                           Text="{Binding Code}" />
                                    <Label Style="{StaticResource PosInfoLabel}"
                                           Text="{Binding Detail}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Style="{StaticResource PosRowSeparator}" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
