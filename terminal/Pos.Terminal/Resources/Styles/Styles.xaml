<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:s="http://smart/maui"
                    xmlns:effects="http://schemas.syncfusion.com/maui/toolkit"
                    xmlns:fonts="clr-namespace:Fonts"
                    xmlns:behaviors="clr-namespace:Pos.Terminal.Behaviors"
                    xmlns:controls="clr-namespace:Pos.Terminal.Controls"
                    xmlns:converters="clr-namespace:Pos.Terminal.Converters"
                    xmlns:models="clr-namespace:Pos.Terminal.Models"
                    xmlns:enums="clr-namespace:Pos.Domain.Enums;assembly=Pos.Domain"
                    xmlns:entity="clr-namespace:Pos.Terminal.Models.Entity">

    <!-- ================================================================================ -->
    <!-- Value -->
    <!-- ================================================================================ -->

    <!-- Color -->

    <Color x:Key="PrimaryTextColor">#DE000000</Color>
    <Color x:Key="SecondaryTextColor">#99000000</Color>
    <Color x:Key="DisabledColor">#61000000</Color>
    <Color x:Key="BorderColor">#1F000000</Color>

    <Color x:Key="SelectFocusColor">#FFF9C4</Color>

    <Color x:Key="NoErrorColor">Transparent</Color>

    <!-- ================================================================================ -->
    <!-- Converter -->
    <!-- ================================================================================ -->

    <!-- Basic -->

    <s:ReverseConverter x:Key="ReverseConverter" />

    <s:NullToBoolConverter x:Key="NotEmptyConverter"
                           HandleEmptyString="True"
                           NullValue="False"
                           NonNullValue="True" />

    <s:CompareToBoolConverter x:Key="GreaterThanToBoolConverter"
                              Expression="{x:Static s:CompareExpressions.GreaterThan}" />

    <s:CompareToBoolConverter x:Key="EqualsConverter"
                              Expression="{x:Static s:CompareExpressions.Equal}" />

    <s:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <converters:EmptyTextConverter x:Key="EmptyTextConverter" />

    <!-- Enum → 文言 -->

    <converters:DisplayNameConverter x:Key="DisplayNameConverter" />

    <!-- 選択マーク -->

    <s:BoolToTextConverter x:Key="SelectedMarkConverter"
                           TrueValue="◉"
                           FalseValue="○" />

    <!-- 状態 → 色 -->

    <s:BoolToColorConverter x:Key="ShiftOpenColorConverter"
                            TrueValue="{StaticResource GreenDarken1}"
                            FalseValue="{StaticResource GrayDefault}" />

    <s:BoolToColorConverter x:Key="FailedBadgeColorConverter"
                            TrueValue="{StaticResource RedDarken1}"
                            FalseValue="{StaticResource OrangeDarken1}" />

    <s:MapToColorConverter x:Key="TransactionTypeColorConverter"
                           DefaultValue="{StaticResource GrayDefault}">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static enums:TransactionType.Sale}" Value="{StaticResource BlueDarken1}" />
            <s:MapToColorEntry Key="{x:Static enums:TransactionType.Return}" Value="{StaticResource OrangeDarken1}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <s:MapToColorConverter x:Key="OutboxStatusColorConverter"
                           DefaultValue="{StaticResource GrayDefault}">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static entity:OutboxStatus.Pending}" Value="{StaticResource OrangeDarken1}" />
            <s:MapToColorEntry Key="{x:Static entity:OutboxStatus.Failed}" Value="{StaticResource RedDarken1}" />
            <s:MapToColorEntry Key="{x:Static entity:OutboxStatus.Sent}" Value="{StaticResource GreenDarken1}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <!-- 一覧の行の背景 (状態を薄い色で示す。取消は画面側のトリガーで赤にする) -->

    <s:MapToColorConverter x:Key="TransactionRowColorConverter"
                           DefaultValue="White">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static enums:TransactionType.Return}" Value="{StaticResource OrangeLighten5}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <s:MapToColorConverter x:Key="OutboxRowColorConverter"
                           DefaultValue="White">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static entity:OutboxStatus.Failed}" Value="{StaticResource RedLighten5}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <s:MapToColorConverter x:Key="StockTypeColorConverter"
                           DefaultValue="{StaticResource BlueGrayLighten2}">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static enums:InventoryChangeType.PhysicalCount}" Value="{StaticResource TealDarken1}" />
            <s:MapToColorEntry Key="{x:Static enums:InventoryChangeType.Adjustment}" Value="{StaticResource AmberDarken2}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <s:MapToTextConverter x:Key="StockTypeTextConverter">
        <s:MapToTextConverter.Entries>
            <s:MapToTextEntry Key="{x:Static enums:InventoryChangeType.PhysicalCount}" Value="棚卸" />
            <s:MapToTextEntry Key="{x:Static enums:InventoryChangeType.Adjustment}" Value="調整" />
        </s:MapToTextConverter.Entries>
    </s:MapToTextConverter>

    <s:MapToTextConverter x:Key="StockTypeIconConverter">
        <s:MapToTextConverter.Entries>
            <s:MapToTextEntry Key="{x:Static enums:InventoryChangeType.PhysicalCount}" Value="{x:Static fonts:MaterialIcons.Assignment}" />
            <s:MapToTextEntry Key="{x:Static enums:InventoryChangeType.Adjustment}" Value="{x:Static fonts:MaterialIcons.Build}" />
        </s:MapToTextConverter.Entries>
    </s:MapToTextConverter>

    <!-- アバター (名前の頭文字とコードで決まる色) -->

    <converters:InitialConverter x:Key="InitialConverter" />

    <converters:AvatarColorConverter x:Key="AvatarColorConverter" />

    <!-- 展開・折りたたみ (Material アイコン) -->

    <s:BoolToTextConverter x:Key="ExpandGlyphConverter"
                           TrueValue="{x:Static fonts:MaterialIcons.Expand_less}"
                           FalseValue="{x:Static fonts:MaterialIcons.Expand_more}" />

    <s:MapToColorConverter x:Key="StaffRoleColorConverter"
                           DefaultValue="{StaticResource BlueGrayLighten1}">
        <s:MapToColorConverter.Entries>
            <s:MapToColorEntry Key="{x:Static enums:StaffRole.Manager}" Value="{StaticResource BlueDarken1}" />
            <s:MapToColorEntry Key="{x:Static enums:StaffRole.Admin}" Value="{StaticResource PurpleDarken1}" />
        </s:MapToColorConverter.Entries>
    </s:MapToColorConverter>

    <!-- 画面固有 (ホーム) -->

    <s:BoolToTextConverter x:Key="ShiftStateTextConverter"
                           TrueValue="開設中"
                           FalseValue="未開設" />

    <s:BoolToTextConverter x:Key="ShiftButtonTextConverter"
                           TrueValue="🔒 精算"
                           FalseValue="🔓 レジ開設" />

    <!-- 画面固有 (棚卸・在庫調整) -->

    <s:BoolToTextConverter x:Key="StockTitleConverter"
                           TrueValue="在庫調整"
                           FalseValue="棚卸" />

    <s:BoolToTextConverter x:Key="StockModeTextConverter"
                           TrueValue="🔧 調整モード: 増減数と理由を入力します。F3 で棚卸に切替"
                           FalseValue="📋 棚卸モード: 実際の在庫数を入力します。F3 で調整に切替" />

    <converters:StockSendTextConverter x:Key="StockSendTextConverter" />

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken4}" />
    </Style>

    <!-- 機能名は左寄せ (右側に 店舗-端末 担当 と未送信バッジを置くため) -->
    <Style x:Key="HeaderTitleLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16,0,8,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Function -->
    <!-- ================================================================================ -->

    <!-- F キー: ヘッダと同じ紺のバーに、F1 = 戻る系 (灰青)、F2 / F3 = 操作 (青)、F4 = 主操作 (橙) -->
    <Style x:Key="FunctionGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken4}" />
    </Style>

    <Style x:Key="FunctionButtonBase"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="FunctionButton1"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken1}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueGrayDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten4}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton2"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten4}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton3"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten4}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton4"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeDarken1}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten4}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Sub Menu -->
    <!-- ================================================================================ -->

    <Style x:Key="SubMenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>

    <Style x:Key="SubMenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="MenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0,1,0,0" />
        <Setter Property="RowSpacing" Value="1" />
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
    </Style>

    <Style x:Key="FillGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="FillVerticalStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <Style x:Key="FillHorizontalStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Button -->
    <!-- ================================================================================ -->

    <!-- Semantic -->

    <!-- ホームのキー: 白の平らなキーを罫線 (MenuGrid の背景) で区切る。販売だけ青で塗る -->
    <Style x:Key="MenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="MenuPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource MenuButton}">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
                            <Setter Property="TextColor" Value="{StaticResource GrayLighten4}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Action -->

    <Style x:Key="ActionButtonBase"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="24" />
    </Style>

