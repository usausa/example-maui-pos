           TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten1}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="PosChipLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="PosChipStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="3" />
    </Style>

    <Style x:Key="PosChipIconLabel"
           TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- 件数や状態のチップを折り返して並べる (StatusChip) -->

    <Style x:Key="PosChipFlexLayout"
           TargetType="FlexLayout">
        <Setter Property="Wrap" Value="Wrap" />
        <Setter Property="AlignItems" Value="Center" />
    </Style>

    <Style x:Key="PosFlexStatusChip"
           TargetType="controls:StatusChip">
        <Setter Property="Margin" Value="0,0,6,2" />
    </Style>

    <!-- Panel (灰色の背景に見出しを置き、その下に幅いっぱいの白い面を並べる。角丸・枠・影は付けない) -->

    <Style x:Key="PosPanelStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="0,0,0,16" />
        <Setter Property="Spacing" Value="0" />
    </Style>

    <Style x:Key="PosPanelGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <!-- 面の中の行 (名前 + 右寄せの値) -->

    <Style x:Key="PosPanelRowGrid"
           TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="PosPanelRowLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PosPanelRowValueLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PosPanelRowStrongLabel"
           TargetType="Label"
           BasedOn="{StaticResource PosPanelRowValueLabel}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- 画面の主な値 (純売上・お釣り・合計) を大きく出す白い帯 -->

    <Style x:Key="PosHeroBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="PosHeroCaptionLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="PosHeroValueLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- 集計の表 (白い升目の間から Grid の背景色を見せて罫線にする) -->

    <Style x:Key="PosStatGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="RowSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten2}" />
    </Style>

    <Style x:Key="PosStatStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <Style x:Key="PosStatCaptionLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PosStatValueLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken4}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PosStatSubLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- 内訳の割合 -->

    <Style x:Key="PosRatioProgressBar"
           TargetType="ProgressBar">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="ProgressColor" Value="{StaticResource BlueLighten1}" />
    </Style>

    <!-- 注意の帯 (未送信など) -->

    <Style x:Key="PosNoticeBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BackgroundColor" Value="{StaticResource AmberLighten5}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="PosNoticeLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OrangeDarken4}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- 帯付きの行 (左端の帯と行の背景で状態を示す。区切り線で並べ、角丸にしない) -->

    <Style x:Key="PosStripRowGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
    </Style>

    <Style x:Key="PosStripBoxView"
           TargetType="BoxView">
        <Setter Property="WidthRequest" Value="6" />
    </Style>

    <Style x:Key="PosStripBodyStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,8,0,8" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- 絵文字付きの情報 (🕒 時刻 / 🧑 担当 / 💳 支払) -->
    <Style x:Key="PosInfoLabel"
           TargetType="Label">
        <Setter Property="FlexLayout.Shrink" Value="0" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PosRowSeparator"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource GrayLighten2}" />
    </Style>

    <Style x:Key="PosExpandButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <!-- 展開した部分 (明細・支払・エラー) -->

    <Style x:Key="PosDetailStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="0,4,0,0" />
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style x:Key="PosDetailRowGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="PosDetailLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PosDetailValueLabel"
           TargetType="Label"
           BasedOn="{StaticResource PosDetailLabel}">
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
    </Style>

    <!-- 一覧の上の件数の内訳 (StatusChip を背景の上に並べる) -->

    <Style x:Key="PosSummaryFlexLayout"
           TargetType="FlexLayout"
           BasedOn="{StaticResource PosChipFlexLayout}">
        <Setter Property="Padding" Value="8,0,8,8" />
    </Style>

    <!-- アバター付きの行 (会員の検索結果) -->

    <Style x:Key="PosAvatarRowGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="PosAvatarBorder"
           TargetType="Border">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PosAvatarLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="PosAvatarTextStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- コード (等幅で桁を揃える) -->
    <Style x:Key="PosCodeLabel"
           TargetType="Label">
        <Setter Property="FlexLayout.Shrink" Value="0" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="TextColor" Value="{StaticResource BlueGrayDarken1}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- タップできる行の波紋 -->

    <Style x:Key="PosRippleView"
           TargetType="effects:SfEffectsView">
        <Setter Property="TouchDownEffects" Value="Ripple" />
    </Style>

    <!-- 見出し付きの集計・詳細 (SummarySection) を見出しと白い面で並べる。表示時に浮き上がらせる -->

    <DataTemplate x:Key="PosSectionTemplate"
                  x:DataType="{x:Type models:SummarySection}">
        <controls:SectionPanel Title="{Binding Title}"
                               behaviors:AnimationOption.EnterAnimation="FadeUp">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:SummaryRow}">
                        <Grid Style="{StaticResource PosPanelRowGrid}"
                              ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource PosPanelRowLabel}"
                                   LineBreakMode="WordWrap"
                                   Text="{Binding Label}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource PosPanelRowValueLabel}"
                                   Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </controls:SectionPanel>
    </DataTemplate>

    <!-- Keypad (会計画面の埋め込みテンキー) -->

    <Style x:Key="PosKeypadGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="8" />
        <Setter Property="RowSpacing" Value="6" />
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten3}" />
    </Style>

    <Style x:Key="PosKeyButton"
           TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="PosShortcutButton"
           TargetType="Button"
           BasedOn="{StaticResource PosKeyButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
        <Setter Property="TextColor" Value="{StaticResource BlueDarken3}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="PosMethodButton"
           TargetType="Button">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- アイコンだけのボタン (番号入力) -->
    <Style x:Key="PosMethodIconButton"
           TargetType="Button"
           BasedOn="{StaticResource PosMethodButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <!-- 濃い背景のボタンの記号は白い単色のアイコンにする (色付きの絵文字は背景に溶ける) -->

    <FontImageSource x:Key="PosSearchIcon"
                     FontFamily="{x:Static fonts:MaterialIcons.FontFamily}"
                     Glyph="{x:Static fonts:MaterialIcons.Search}"
                     Color="White"
                     Size="18" />

    <FontImageSource x:Key="PosDialpadIcon"
                     FontFamily="{x:Static fonts:MaterialIcons.FontFamily}"
                     Glyph="{x:Static fonts:MaterialIcons.Dialpad}"
                     Color="White"
                     Size="18" />

    <FontImageSource x:Key="PosCartIcon"
                     FontFamily="{x:Static fonts:MaterialIcons.FontFamily}"
                     Glyph="{x:Static fonts:MaterialIcons.Shopping_cart}"
                     Color="White"
                     Size="30" />

    <!-- Field (フォーム入力) -->

    <Style x:Key="PosFieldLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16,8,16,0" />
        <Setter Property="TextColor" Value="{StaticResource GrayDarken1}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PosFieldEntry"
           TargetType="Entry">
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="behaviors:Border.Color" Value="{StaticResource BorderColor}" />
        <Setter Property="behaviors:Border.Width" Value="1" />
        <Setter Property="behaviors:EntryOption.HandleEnterKey" Value="True" />
    </Style>

    <Style x:Key="PosFieldValueButton"
           TargetType="Button">
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource BlueDarken2}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- 番号・数値の入力欄: タップで電卓 (InputNumber) を開く。OS のキーボードは使わない -->
    <Style x:Key="PosFieldInputButton"
           TargetType="Button"
           BasedOn="{StaticResource PosFieldValueButton}">
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="PosCountButton"
           TargetType="Button"
           BasedOn="{StaticResource PosFieldValueButton}">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="PosSelectButton"
           TargetType="Button">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="PosSelectedButton"
           TargetType="Button"
           BasedOn="{StaticResource PosSelectButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="PosReceiptLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16" />
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

</ResourceDictionary>
