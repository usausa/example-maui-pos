<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Pos.Terminal</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>

    <!-- XA4301: BarcodeScanning.Native.Maui が MLKit と同じ libbarhopper_v3.so を同梱するための重複警告。アプリ側では解消できない -->
    <NoWarn>$(NoWarn);XA4301</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>POS</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>pos.terminal</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  -->

  <!--
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  -->

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>example.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>example</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>example</AndroidSigningKeyPass>
    <AndroidSigningStorePass>example</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.5" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D47A1" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'true'">
    <Compile Update="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'false'">
    <Compile Remove="**\*.android.cs" />
    <None Include="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'true'">
    <Compile Update="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'false'">
    <Compile Remove="**\*.ios.cs" />
    <None Include="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BarcodeScanning.Native.Maui" Version="3.1.0" />
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.6.0" />
    <PackageReference Include="BunnyTail.EmbeddedBuildProperty" Version="1.19.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BunnyTail.MemberAccessor" Version="1.16.0" />
    <PackageReference Include="BunnyTail.XamlProperty.Maui" Version="1.2.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="Components.Maui" Version="1.46.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.101" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.152.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Plugin.Maui.DebugRainbows" Version="1.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.11" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Converter" Version="2.17.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.20.0" />
    <PackageReference Include="Usa.Smart.Data" Version="2.11.0" />
    <PackageReference Include="Usa.Smart.Data.Accessor" Version="3.0.0-beta12" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.0.0-beta8" />
    <PackageReference Include="Usa.Smart.Maui" Version="2.26.0" />
    <PackageReference Include="Usa.Smart.Maui.Extensions" Version="2.26.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.12.0" />
    <PackageReference Include="Usa.Smart.Navigation" Version="3.11.0" />
    <PackageReference Include="Usa.Smart.Navigation.Extensions.DependencyInjection" Version="3.11.0" />
    <PackageReference Include="Usa.Smart.Navigation.Maui" Version="3.11.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
    <PackageReference Include="Usa.Smart.Results" Version="2.2.0" />
    <!-- Xamarin.AndroidX.Fragment.Ktx: BarcodeScanning.Native.Maui が古い ktx を参照するため Xamarin.AndroidX.Fragment 1.9.0 に合わせる -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Pos.Domain\Pos.Domain.csproj" />
    <ProjectReference Include="..\..\shared\Pos.Contract\Pos.Contract.csproj" />
  </ItemGroup>

</Project>
