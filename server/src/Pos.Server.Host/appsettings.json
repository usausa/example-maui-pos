{
  "http_ports": "8080",

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=pos.db;Cache=Shared;Pooling=True;Foreign Keys=True"
  },

  "Log": {
    "HttpLog": false
  },

  "Profiler": {
    "SqlLog": {
      "Enable": false,
      "OutputParameter": true,
      "ElapsedThresholdMilliseconds": 0
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/Pos.Server.Host_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
