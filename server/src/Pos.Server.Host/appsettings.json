{
  "http_ports": "8080",

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=pos.db;Cache=Shared;Pooling=True;Foreign Keys=True"
  },

  "Auth": {
    "Enabled": true,
    "ExpireMinutes": 480,
    "AttemptsPerMinute": 10,
    "InitialName": "admin",
    "InitialPassword": "admin"
  },

  "Log": {
    "HttpLog": false,
    "HttpDump": false,
    "HttpDumpLimit": 4096,
    "W3CLog": {
      "Enable": false,
      "Directory": "../log",
      "FileName": "access-",
      "RetainedFileCount": 4
    }
  },

  "Profiler": {
    "SqlLog": {
      "Enable": false,
      "OutputParameter": true,
      "ElapsedThresholdMilliseconds": 0
    },
    "SqlTelemetry": {
      "Enable": false
    }
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Telemetry": {
    "LongExecutionThreshold": 5000
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/Pos.Server.Host_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
