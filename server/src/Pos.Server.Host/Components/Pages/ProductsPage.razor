@page "/products"
@inherits PageComponentBase

<PageTitle>POS 管理 - 商品</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">🏷 商品</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Size="Size.Small" Href="api/v1/products/csv">CSV</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="IsBusy" OnClick="AddAsync">追加</MudButton>
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudSelect T="Guid?" @bind-Value="categoryId" Label="部門" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 200px;">
            <MudSelectItem T="Guid?" Value="null">すべて</MudSelectItem>
            @foreach (var category in categories)
            {
                <MudSelectItem T="Guid?" Value="category.Id">@category.ToIndentedName()</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="keyword" Label="キーワード (コード / JAN / 名称 / かな / 型番)" Clearable="true" Immediate="true" OnKeyDown="OnSearchKeyDown" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 320px;" />
        <MudSelect T="bool?" @bind-Value="isActive" Label="販売状態" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 140px;">
            <MudSelectItem T="bool?" Value="null">すべて</MudSelectItem>
            <MudSelectItem T="bool?" Value="true">✅ 販売中</MudSelectItem>
            <MudSelectItem T="bool?" Value="false">⏸ 販売停止</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" @bind-Value="includeDeleted" Label="削除済みを表示" Color="Color.Primary" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" OnClick="SearchAsync">検索</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudDataGrid @ref="Grid" T="ProductEntity" ServerData="LoadServerData" SortMode="SortMode.Single" Dense="true" Hover="true" Bordered="true" Striped="true" HorizontalScrollbar="true" Class="grid-nowrap">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="コード" />
        <PropertyColumn Property="x => x.Barcode" Title="JAN" Sortable="false" />
        <PropertyColumn Property="x => x.Name" Title="商品名" />
        <TemplateColumn Title="部門" Sortable="false">
            <CellTemplate>@CategoryName(context.Item.CategoryId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="種別" Sortable="false">
            <CellTemplate>@context.Item.Kind.ToDisplayName()</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Price" Title="価格" CellStyle="text-align: right;" HeaderStyle="text-align: right;">
            <CellTemplate>@context.Item.Price.ToYen() (@context.Item.TaxIncluded.ToTaxIncludedText())</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="税率" Sortable="false">
            <CellTemplate>@TaxRateName(context.Item.TaxRateId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="還元率" Sortable="false" CellStyle="text-align: right;">
            <CellTemplate>@context.Item.PointRate.ToPercentText()</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="属性" Sortable="false">
            <CellTemplate>
                @if (context.Item.TrackInventory)
                {
                    <span title="在庫管理">📦</span>
                }
                @if (context.Item.RequiresSerial)
                {
                    <span title="シリアル要">🔢</span>
                }
                @if (context.Item.AllowsPriceOverride)
                {
                    <span title="売価変更可">✏️</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="状態" Sortable="false">
            <CellTemplate><StatusChip Value="@(context.Item.IsDeleted ? ViewHelper.DeletedChip() : ViewHelper.ActiveChip(context.Item.IsActive))" /></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false" CellStyle="width: 100px; white-space: nowrap;">
            <CellTemplate>
                @if (!context.Item.IsDeleted)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsBusy" OnClick="() => EditAsync(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="IsBusy" OnClick="() => DeleteAsync(context.Item)" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>商品がありません。</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="ProductEntity" RowsPerPageString="表示件数:" InfoFormat="{first_item}-{last_item} / {all_items} 件" />
    </PagerContent>
</MudDataGrid>
