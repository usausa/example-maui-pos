@page "/"
@inherits PageComponentBase

<PageTitle>POS 管理 - ダッシュボード</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📊 ダッシュボード</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">本日 @today.ToDateText()・自動更新</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudGrid Spacing="2" Class="mb-2">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 d-flex flex-column kpi-card" Elevation="1">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">本日売上 (純)</MudText>
            </div>
            <MudText Typo="Typo.h6">¥@todaySummary.NetSales.ToYen()</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">値引 ¥@todaySummary.DiscountTotal.ToYen()</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 d-flex flex-column kpi-card" Elevation="1">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">本日客数</MudText>
            </div>
            <MudText Typo="Typo.h6">@todaySummary.TransactionCount 件</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">客単価 ¥@AveragePerCustomer.ToYen()</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 d-flex flex-column kpi-card" Elevation="1">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentReturn" Color="Color.Warning" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">本日返品</MudText>
            </div>
            <MudText Typo="Typo.h6" Color="@(todaySummary.ReturnCount > 0 ? Color.Warning : Color.Default)">¥@todaySummary.ReturnsTotal.ToYen()</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@todaySummary.ReturnCount 件</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 d-flex flex-column kpi-card" Elevation="1">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="@(WarningCount > 0 ? Color.Error : Color.Default)" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">要確認</MudText>
            </div>
            <MudText Typo="Typo.h6" Color="@(WarningCount > 0 ? Color.Error : Color.Default)">@WarningCount 件</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">在庫 @NegativeInventoryCount / ポイント @negativeCustomers.Count / 未締め @UnclosedDayCount</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="mb-2">
            <MudTable T="SalesSummaryView" Items="storeRows" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="pa-2">🏬 店舗別売上 (本日)</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>店舗</MudTh>
                    <MudTh Class="text-right">件数</MudTh>
                    <MudTh Class="text-right">純売上</MudTh>
                    <MudTh Class="text-right">返品</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.GroupLabel</MudTd>
                    <MudTd Class="text-right">@context.TransactionCount</MudTd>
                    <MudTd Class="text-right">¥@context.NetSales.ToYen()</MudTd>
                    <MudTd Class="text-right">¥@context.ReturnsTotal.ToYen()</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">本日の売上はまだありません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
        <MudPaper Elevation="1">
            <MudTable T="OrderDetailView" Items="arrivedOrders" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="arrivedOrderCount" Color="Color.Warning" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="arrivedOrderCount > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">📋 引き渡し待ちの受注</MudText>
                    </MudBadge>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ml-8">入荷待ち @orderedCount 件</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Href="orders" Variant="Variant.Text">一覧へ</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>受注番号</MudTh>
                    <MudTh>お客様</MudTh>
                    <MudTh>電話</MudTh>
                    <MudTh>希望日</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudLink Href="@($"orders?id={context.Order.Id}")" Typo="Typo.body2">@context.Order.OrderNo</MudLink></MudTd>
                    <MudTd>@context.Order.CustomerName</MudTd>
                    <MudTd>@context.Order.Phone</MudTd>
                    <MudTd>@context.Order.RequestedDate.ToDateText()</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">引き渡し待ちの受注はありません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="mb-2">
            <MudTable T="ShiftEntity" Items="openShifts" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="openShifts.Count" Color="Color.Success" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="openShifts.Count > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">🟢 開設中シフト</MudText>
                    </MudBadge>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>店舗 / 端末</MudTh>
                    <MudTh>担当</MudTh>
                    <MudTh>営業日</MudTh>
                    <MudTh>開設時刻</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@names.Store(context.StoreId) / @names.Terminal(context.TerminalId)</MudTd>
                    <MudTd>@names.StaffName(context.OpenedByStaffId)</MudTd>
                    <MudTd>@context.BusinessDate.ToDateText()</MudTd>
                    <MudTd>@context.OpenedAt.ToDateTimeText()</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">開設中のシフトはありません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
        <MudPaper Elevation="1">
            <MudTable T="DailyClosingDayView" Items="unclosedDays" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="UnclosedDayCount" Color="Color.Warning" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="UnclosedDayCount > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">🗓️ 未締めの営業日 (前日まで)</MudText>
                    </MudBadge>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Href="daily-closings?unclosed=true" Variant="Variant.Text">一覧へ</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>営業日</MudTh>
                    <MudTh>店舗</MudTh>
                    <MudTh>シフト</MudTh>
                    <MudTh Class="text-right">純売上</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.BusinessDate.ToDateText()</MudTd>
                    <MudTd>@names.Store(context.StoreId)</MudTd>
                    <MudTd>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <span>@context.ShiftCount 件</span>
                            @if (context.OpenShiftCount > 0)
                            {
                                <StatusChip Value="@ViewHelper.OpenShiftChip(context.OpenShiftCount)" />
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd Class="text-right">¥@context.NetSales.ToYen()</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">✅ 前日までの営業日はすべて締め済みです。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="mb-2">
            <MudTable T="TerminalEntity" Items="terminals" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="pa-2">📱 端末の通信状態</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>店舗 / 端末</MudTh>
                    <MudTh>状態</MudTh>
                    <MudTh>アプリ版</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@names.Store(context.StoreId) / @context.Name</MudTd>
                    <MudTd><StatusChip Value="@ViewHelper.OnlineChip(context.LastSeenAt, TerminalService.IsOnline(context.LastSeenAt))" /></MudTd>
                    <MudTd>@context.AppVersion</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
        <MudPaper Elevation="1">
            <MudTable T="InventoryTransferDetailView" Items="openTransfers" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="OpenTransferCount" Color="Color.Warning" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="OpenTransferCount > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">🚚 未受領の移動</MudText>
                    </MudBadge>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ml-8">出荷待ち @requestedTransferCount 件 / 受領待ち @shippedTransferCount 件</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Href="inventory/transfers" Variant="Variant.Text">一覧へ</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>移動番号</MudTh>
                    <MudTh>出荷店 → 入荷店</MudTh>
                    <MudTh>状態</MudTh>
                    <MudTh>依頼日時</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="no-wrap"><MudLink Href="@($"inventory/transfers?id={context.Transfer.Id}")" Typo="Typo.body2">@context.Transfer.TransferNo</MudLink></MudTd>
                    <MudTd>@names.Store(context.Transfer.FromStoreId) → @names.Store(context.Transfer.ToStoreId)</MudTd>
                    <MudTd><StatusChip Value="@ViewHelper.InventoryTransferStatusChip(context.Transfer.Status)" /></MudTd>
                    <MudTd Class="no-wrap">@context.Transfer.CreatedAt.ToShortDateTimeText()</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">未受領の移動はありません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="mb-2">
            <MudTable T="InventoryLevelDetailView" Items="negativeInventory" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="NegativeInventoryCount" Color="Color.Error" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="NegativeInventoryCount > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">⚠️ 在庫マイナス</MudText>
                    </MudBadge>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Href="inventory" Variant="Variant.Text">一覧へ</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>商品</MudTh>
                    <MudTh>店舗</MudTh>
                    <MudTh Class="text-right">数量</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductCode @context.ProductName</MudTd>
                    <MudTd>@context.StoreName</MudTd>
                    <MudTd Class="text-right"><StatusChip Value="@ViewHelper.NegativeQuantityChip(context.Quantity)" /></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">✅ 在庫がマイナスの商品はありません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
        <MudPaper Elevation="1">
            <MudTable T="CustomerEntity" Items="negativeCustomers" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                <ToolBarContent>
                    <MudBadge Content="negativeCustomers.Count" Color="Color.Error" Origin="Origin.CenterRight" BadgeClass="ml-1" Visible="negativeCustomers.Count > 0">
                        <MudText Typo="Typo.subtitle1" Class="pa-2">⚠️ ポイント残高マイナス</MudText>
                    </MudBadge>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>会員</MudTh>
                    <MudTh Class="text-right">残高</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudLink Href="@($"customers/{context.Id}")" Typo="Typo.body2">@context.Code @context.Name</MudLink></MudTd>
                    <MudTd Class="text-right"><StatusChip Value="@ViewHelper.PointBalanceChip(context.PointBalance)" /></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">✅ 残高がマイナスの会員はいません。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>
