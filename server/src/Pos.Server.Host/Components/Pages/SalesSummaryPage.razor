@page "/reports/sales"
@inherits PageComponentBase

<PageTitle>POS 管理 - 売上集計</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📈 売上集計</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Size="Size.Small" Href="@CsvUrl" Disabled="IsBusy">CSV</MudButton>
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker Class="min-w-260" @bind-DateRange="period" Label="期間 (営業日)" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudSelect Class="min-w-150" T="SalesSummaryGroupBy" @bind-Value="groupBy" Label="集計単位" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            @foreach (var value in Enum.GetValues<SalesSummaryGroupBy>())
            {
                <MudSelectItem T="SalesSummaryGroupBy" Value="value">@value.ToDisplayName()</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">集計</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

@if (rows.Count > 0)
{
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">💴 純売上</MudText>
                <MudText Typo="Typo.h6">@total.NetSales.ToYen() 円</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">🧾 販売 / 返品件数</MudText>
                <MudText Typo="Typo.h6">@total.TransactionCount / @total.ReturnCount 件</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">🏷 値引</MudText>
                <MudText Typo="Typo.h6">@total.DiscountTotal.ToYen() 円</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">⭐ ポイント付与 / 利用</MudText>
                <MudText Typo="Typo.h6">@total.PointsEarned.ToPointText() / @total.PointsRedeemed.ToPointText()</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-2 mb-2">
        <MudText Typo="Typo.subtitle2" Class="mb-1">純売上 (@groupBy.ToDisplayName())</MudText>
        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="chartSeries" ChartLabels="chartLabels" ChartOptions="chartOptions" Height="260px" />
    </MudPaper>
}

<MudTable T="SalesSummaryView" Items="rows" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>@groupBy.ToDisplayName()</MudTh>
        <MudTh Class="text-right">販売件数</MudTh>
        <MudTh Class="text-right">返品件数</MudTh>
        <MudTh Class="text-right">客数</MudTh>
        <MudTh Class="text-right">売上</MudTh>
        <MudTh Class="text-right">返品</MudTh>
        <MudTh Class="text-right">純売上</MudTh>
        <MudTh Class="text-right">値引</MudTh>
        <MudTh Class="text-right">@ViewHelper.TaxColumnHeader(groupBy)</MudTh>
        <MudTh Class="text-right">pt 付与 / 利用</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.GroupLabel</MudTd>
        <MudTd Class="text-right">@context.TransactionCount</MudTd>
        <MudTd Class="text-right">@context.ReturnCount</MudTd>
        <MudTd Class="text-right">@context.CustomerCount</MudTd>
        <MudTd Class="text-right">@context.SalesTotal.ToYen()</MudTd>
        <MudTd Class="text-right">@context.ReturnsTotal.ToYen()</MudTd>
        <MudTd Class="text-right"><strong>@context.NetSales.ToYen()</strong></MudTd>
        <MudTd Class="text-right">@context.DiscountTotal.ToYen()</MudTd>
        <MudTd Class="text-right">@context.ToTaxText(groupBy)</MudTd>
        <MudTd Class="text-right">@context.PointsEarned.ToPointText() / @context.PointsRedeemed.ToPointText()</MudTd>
    </RowTemplate>
    <FooterContent>
        @if (rows.Count > 0)
        {
            <MudTFootRow Class="font-weight-bold">
                <MudTd>合計</MudTd>
                <MudTd Class="text-right">@total.TransactionCount</MudTd>
                <MudTd Class="text-right">@total.ReturnCount</MudTd>
                <MudTd Class="text-right">@total.CustomerCount</MudTd>
                <MudTd Class="text-right">@total.SalesTotal.ToYen()</MudTd>
                <MudTd Class="text-right">@total.ReturnsTotal.ToYen()</MudTd>
                <MudTd Class="text-right">@total.NetSales.ToYen()</MudTd>
                <MudTd Class="text-right">@total.DiscountTotal.ToYen()</MudTd>
                <MudTd Class="text-right">@total.ToTaxText(groupBy)</MudTd>
                <MudTd Class="text-right">@total.PointsEarned.ToPointText() / @total.PointsRedeemed.ToPointText()</MudTd>
            </MudTFootRow>
        }
    </FooterContent>
    <NoRecordsContent>
        <MudText>期間内の取引がありません。</MudText>
    </NoRecordsContent>
</MudTable>

<MudPaper Class="pa-2 mt-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudText Typo="Typo.subtitle2">📄 売上日報 PDF</MudText>
        <StoreSelect @bind-Value="reportStoreId" AllowAll="false" />
        <MudDatePicker @bind-Date="reportDate" Label="営業日" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Class="filter-select" />
        <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="@DailyPdfUrl" Target="_blank" Disabled="@(reportStoreId is null || reportDate is null)">売上日報を開く</MudButton>
    </MudStack>
</MudPaper>
