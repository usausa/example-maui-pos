@page "/reports/sales"
@inherits PageComponentBase

<PageTitle>POS 管理 - 売上集計</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📈 売上集計</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Size="Size.Small" Href="@CsvUrl" Disabled="IsBusy">CSV</MudButton>
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker @bind-DateRange="period" Label="期間 (営業日)" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 260px;" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudSelect T="SalesSummaryGroupBy" @bind-Value="groupBy" Label="集計単位" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 150px;">
            @foreach (var value in Enum.GetValues<SalesSummaryGroupBy>())
            {
                <MudSelectItem T="SalesSummaryGroupBy" Value="value">@DisplayText.Name(value)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">集計</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

@if (rows.Count > 0)
{
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">💴 純売上</MudText>
                <MudText Typo="Typo.h6">@DisplayText.Yen(total.NetSales) 円</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">🧾 販売 / 返品件数</MudText>
                <MudText Typo="Typo.h6">@total.TransactionCount / @total.ReturnCount 件</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">🏷 値引</MudText>
                <MudText Typo="Typo.h6">@DisplayText.Yen(total.DiscountTotal) 円</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">⭐ ポイント付与 / 利用</MudText>
                <MudText Typo="Typo.h6">@total.PointsEarned.ToString("N0") / @total.PointsRedeemed.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-2 mb-2">
        <MudText Typo="Typo.subtitle2" Class="mb-1">純売上 (@DisplayText.Name(groupBy))</MudText>
        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="chartSeries" ChartLabels="chartLabels" ChartOptions="chartOptions" Height="260px" />
    </MudPaper>
}

<MudTable T="SalesSummaryRow" Items="rows" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>@DisplayText.Name(groupBy)</MudTh>
        <MudTh Style="text-align: right;">販売件数</MudTh>
        <MudTh Style="text-align: right;">返品件数</MudTh>
        <MudTh Style="text-align: right;">客数</MudTh>
        <MudTh Style="text-align: right;">売上</MudTh>
        <MudTh Style="text-align: right;">返品</MudTh>
        <MudTh Style="text-align: right;">純売上</MudTh>
        <MudTh Style="text-align: right;">値引</MudTh>
        <MudTh Style="text-align: right;">@(groupBy == SalesSummaryGroupBy.TaxRate ? "課税対象 / 税額" : "税")</MudTh>
        <MudTh Style="text-align: right;">pt 付与 / 利用</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.GroupLabel</MudTd>
        <MudTd Style="text-align: right;">@context.TransactionCount</MudTd>
        <MudTd Style="text-align: right;">@context.ReturnCount</MudTd>
        <MudTd Style="text-align: right;">@context.CustomerCount</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Yen(context.SalesTotal)</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Yen(context.ReturnsTotal)</MudTd>
        <MudTd Style="text-align: right;"><strong>@DisplayText.Yen(context.NetSales)</strong></MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Yen(context.DiscountTotal)</MudTd>
        <MudTd Style="text-align: right;">@(groupBy == SalesSummaryGroupBy.TaxRate ? $"{DisplayText.Yen(context.TaxableAmount)} / {DisplayText.Yen(context.TaxAmount)}" : DisplayText.Yen(context.TaxTotal))</MudTd>
        <MudTd Style="text-align: right;">@context.PointsEarned.ToString("N0") / @context.PointsRedeemed.ToString("N0")</MudTd>
    </RowTemplate>
    <FooterContent>
        @if (rows.Count > 0)
        {
            <MudTFootRow Style="font-weight: bold;">
                <MudTd>合計</MudTd>
                <MudTd Style="text-align: right;">@total.TransactionCount</MudTd>
                <MudTd Style="text-align: right;">@total.ReturnCount</MudTd>
                <MudTd Style="text-align: right;">@total.CustomerCount</MudTd>
                <MudTd Style="text-align: right;">@DisplayText.Yen(total.SalesTotal)</MudTd>
                <MudTd Style="text-align: right;">@DisplayText.Yen(total.ReturnsTotal)</MudTd>
                <MudTd Style="text-align: right;">@DisplayText.Yen(total.NetSales)</MudTd>
                <MudTd Style="text-align: right;">@DisplayText.Yen(total.DiscountTotal)</MudTd>
                <MudTd Style="text-align: right;">@(groupBy == SalesSummaryGroupBy.TaxRate ? $"{DisplayText.Yen(total.TaxableAmount)} / {DisplayText.Yen(total.TaxAmount)}" : DisplayText.Yen(total.TaxTotal))</MudTd>
                <MudTd Style="text-align: right;">@total.PointsEarned.ToString("N0") / @total.PointsRedeemed.ToString("N0")</MudTd>
            </MudTFootRow>
        }
    </FooterContent>
    <NoRecordsContent>
        <MudText>期間内の取引がありません。</MudText>
    </NoRecordsContent>
</MudTable>

<MudPaper Class="pa-2 mt-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudText Typo="Typo.subtitle2">📄 売上日報 PDF</MudText>
        <StoreSelect @bind-Value="reportStoreId" AllowAll="false" />
        <MudDatePicker @bind-Date="reportDate" Label="営業日" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width: 160px;" />
        <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="@DailyPdfUrl" Target="_blank" Disabled="@(reportStoreId is null || reportDate is null)">売上日報を開く</MudButton>
    </MudStack>
</MudPaper>
