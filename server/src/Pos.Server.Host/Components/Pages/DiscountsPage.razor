@page "/discounts"
@inherits PageComponentBase

<PageTitle>POS 管理 - 値引</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">🏷 値引</MudText>
    <MudSpacer />
    <MudSwitch T="bool" @bind-Value="includeDeleted" @bind-Value:after="LoadAsync" Label="削除済みを表示" Color="Color.Primary" />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="IsBusy" OnClick="AddAsync">追加</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="DiscountEntity" Items="items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>コード</MudTh>
        <MudTh>名称</MudTh>
        <MudTh>種別</MudTh>
        <MudTh Style="text-align: right;">値</MudTh>
        <MudTh>適用範囲</MudTh>
        <MudTh>承認</MudTh>
        <MudTh>状態</MudTh>
        <MudTh Style="text-align: right;">並び順</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@DisplayText.Name(context.Type)</MudTd>
        <MudTd Style="text-align: right;">@(context.Type == DiscountType.Percent ? DisplayText.Percent(context.Value) : DisplayText.Yen(context.Value) + " 円")</MudTd>
        <MudTd>@DisplayText.Name(context.Scope)</MudTd>
        <MudTd>@(context.RequiresApproval ? "🔑 承認要" : string.Empty)</MudTd>
        <MudTd><StatusChip Value="@(context.IsDeleted ? ChipText.Deleted() : ChipText.Active(context.IsActive))" /></MudTd>
        <MudTd Style="text-align: right;">@context.SortOrder</MudTd>
        <MudTd Class="no-wrap">
            @if (!context.IsDeleted)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsBusy" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="IsBusy" OnClick="() => DeleteAsync(context)" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>値引がありません。</MudText>
    </NoRecordsContent>
</MudTable>
