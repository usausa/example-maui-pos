@page "/terminals"
@inherits PageComponentBase

<PageTitle>POS 管理 - レジ端末</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">🏬 レジ端末</MudText>
    <MudSpacer />
    <MudSwitch T="bool" @bind-Value="includeDeleted" @bind-Value:after="LoadAsync" Label="削除済みを表示" Color="Color.Primary" />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="IsBusy" OnClick="AddAsync">追加</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="TerminalEntity" Items="items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>店舗</MudTh>
        <MudTh>端末番号</MudTh>
        <MudTh>名称</MudTh>
        <MudTh>状態</MudTh>
        <MudTh>最終通信</MudTh>
        <MudTh>アプリ版</MudTh>
        <MudTh Class="text-right">最終レシート連番</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@StoreName(context.StoreId)</MudTd>
        <MudTd>@context.TerminalNo.ToTerminalNoText()</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd><StatusChip Value="@(context.IsDeleted ? ViewHelper.DeletedChip() : ViewHelper.ActiveChip(context.IsActive))" /></MudTd>
        <MudTd Class="no-wrap"><StatusChip Value="@ViewHelper.OnlineChip(context.LastSeenAt, TerminalService.IsOnline(context.LastSeenAt))" /></MudTd>
        <MudTd>@context.AppVersion</MudTd>
        <MudTd Class="text-right">@context.LastReceiptSeq</MudTd>
        <MudTd Class="no-wrap">
            @if (!context.IsDeleted)
            {
                <MudTooltip Text="設定 QR">
                    <MudIconButton Icon="@Icons.Material.Filled.QrCode" Size="Size.Small" Disabled="IsBusy" OnClick="() => ShowQrAsync(context)" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsBusy" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="IsBusy" OnClick="() => DeleteAsync(context)" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>端末がありません。</MudText>
    </NoRecordsContent>
</MudTable>
