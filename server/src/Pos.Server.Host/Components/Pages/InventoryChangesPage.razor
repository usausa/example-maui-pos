@page "/inventory/changes"
@inherits PageComponentBase

<PageTitle>POS 管理 - 在庫変動履歴</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📦 在庫変動履歴</MudText>
    <MudSpacer />
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker Class="filter-range" @bind-DateRange="period" Label="期間" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudAutocomplete Class="min-w-280" T="ProductEntity" @bind-Value="product" Label="商品" SearchFunc="SearchProductsAsync" ToStringFunc="@(x => x is null ? string.Empty : x.ToDisplayText())" ResetValueOnEmptyText="true" Clearable="true" MinCharacters="1" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudSelect Class="min-w-130" T="InventoryChangeType?" @bind-Value="type" Label="種別" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="InventoryChangeType?" Value="null">すべて</MudSelectItem>
            @foreach (var value in Enum.GetValues<InventoryChangeType>())
            {
                <MudSelectItem T="InventoryChangeType?" Value="value">@ViewHelper.ChangeTypeChip(value).Text</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" OnClick="SearchAsync">検索</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudDataGrid @ref="Grid" T="InventoryChangeEntity" ServerData="LoadServerData" SortMode="SortMode.None" Dense="true" Hover="true" Bordered="true" Striped="true" HorizontalScrollbar="true" Class="grid-nowrap">
    <Columns>
        <TemplateColumn Title="日時">
            <CellTemplate>@context.Item.OccurredAt.ToDateTimeText()</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="店舗">
            <CellTemplate>@names.Store(context.Item.StoreId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="商品">
            <CellTemplate>@ProductName(context.Item.ProductId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="種別">
            <CellTemplate><StatusChip Value="@ViewHelper.ChangeTypeChip(context.Item.Type)" /></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="増減" CellClass="text-right">
            <CellTemplate>@context.Item.QuantityDelta.ToDeltaText()</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="処理後" CellClass="text-right">
            <CellTemplate>@context.Item.QuantityAfter.ToQuantityText()</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="理由">
            <CellTemplate>@ReasonName(context.Item.ReasonId) @context.Item.Reason</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="参照">
            <CellTemplate>
                @if (context.Item.ReferenceId is { } referenceId)
                {
                    var link = ViewHelper.ReferenceLink(context.Item.ReferenceType, referenceId);
                    <MudLink Href="@link.Href" Typo="Typo.body2">@link.Text</MudLink>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="担当">
            <CellTemplate>@names.StaffName(context.Item.StaffId)</CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>変動履歴がありません。</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="InventoryChangeEntity" RowsPerPageString="表示件数:" InfoFormat="{first_item}-{last_item} / {all_items} 件" />
    </PagerContent>
</MudDataGrid>
