@page "/transactions"
@inherits PageComponentBase

<PageTitle>POS 管理 - 取引</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">🧾 取引</MudText>
    <MudSpacer />
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker Class="filter-range" @bind-DateRange="period" Label="営業日" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudSelect Class="min-w-160" T="Guid?" @bind-Value="terminalId" Label="端末" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="Guid?" Value="null">すべて</MudSelectItem>
            @foreach (var terminal in names.TerminalsOf(storeId))
            {
                <MudSelectItem T="Guid?" Value="terminal.Id">@terminal.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Class="min-w-120" T="TransactionType?" @bind-Value="type" Label="種別" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="TransactionType?" Value="null">すべて</MudSelectItem>
            <MudSelectItem T="TransactionType?" Value="TransactionType.Sale">🛒 販売</MudSelectItem>
            <MudSelectItem T="TransactionType?" Value="TransactionType.Return">↩️ 返品</MudSelectItem>
        </MudSelect>
        <MudSelect Class="min-w-120" T="TransactionStatus?" @bind-Value="status" Label="状態" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="TransactionStatus?" Value="null">すべて</MudSelectItem>
            <MudSelectItem T="TransactionStatus?" Value="TransactionStatus.Completed">✅ 完了</MudSelectItem>
            <MudSelectItem T="TransactionStatus?" Value="TransactionStatus.Voided">❌ 取消</MudSelectItem>
        </MudSelect>
        <MudTextField Class="min-w-180 search-field" @bind-Value="receiptNo" Label="レシート番号" Clearable="true" Immediate="true" OnKeyDown="OnSearchKeyDown" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudTextField Class="min-w-180 search-field" @bind-Value="serialNumber" Label="シリアル番号" Clearable="true" Immediate="true" OnKeyDown="OnSearchKeyDown" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" OnClick="SearchAsync">検索</MudButton>
        @if (ShiftId is not null)
        {
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.FilterAlt" OnClose="ClearShiftAsync">シフトで絞り込み中</MudChip>
        }
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudDataGrid @ref="Grid" T="TransactionEntity" ServerData="LoadServerData" SortMode="SortMode.Single" Dense="true" Hover="true" Bordered="true" Striped="true" RowClick="OnRowClick" RowClass="cursor-pointer" HorizontalScrollbar="true" Class="grid-nowrap">
    <Columns>
        <PropertyColumn Property="x => x.TransactedAt" Title="日時" InitialDirection="SortDirection.Descending">
            <CellTemplate>@context.Item.TransactedAt.ToDateTimeText()</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ReceiptNo" Title="レシート番号" />
        <TemplateColumn Title="店舗 / 端末" Sortable="false">
            <CellTemplate>@names.Store(context.Item.StoreId) / @names.Terminal(context.Item.TerminalId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="担当" Sortable="false">
            <CellTemplate>@names.StaffName(context.Item.StaffId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="種別" Sortable="false">
            <CellTemplate><StatusChip Value="@ViewHelper.TypeChip(context.Item.Type)" /></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="状態" Sortable="false">
            <CellTemplate><StatusChip Value="@ViewHelper.StatusChip(context.Item.Status)" /></CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Total" Title="合計" CellClass="text-right" HeaderClass="text-right">
            <CellTemplate>@context.Item.Total.ToYen()</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="ポイント" Sortable="false" CellClass="text-right">
            <CellTemplate>
                @if (context.Item.PointsEarned != 0 || context.Item.PointsRedeemed != 0)
                {
                    <span title="付与 / 利用">@context.Item.PointsEarned.ToDeltaText() / @((-context.Item.PointsRedeemed).ToDeltaText())</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="会員" Sortable="false">
            <CellTemplate>@ViewHelper.CustomerMark(context.Item.CustomerId is not null)</CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>取引がありません。</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="TransactionEntity" RowsPerPageString="表示件数:" InfoFormat="{first_item}-{last_item} / {all_items} 件" />
    </PagerContent>
</MudDataGrid>
