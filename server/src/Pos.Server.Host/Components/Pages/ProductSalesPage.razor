@page "/reports/products"
@inherits PageComponentBase

<PageTitle>POS 管理 - 商品別売上</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📈 商品別売上</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Size="Size.Small" Href="@CsvUrl" Disabled="IsBusy">CSV</MudButton>
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker Class="filter-range" @bind-DateRange="period" Label="期間 (営業日)" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudSelect Class="min-w-200" T="Guid?" @bind-Value="categoryId" Label="部門" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem T="Guid?" Value="null">すべて</MudSelectItem>
            @foreach (var category in categories)
            {
                <MudSelectItem T="Guid?" Value="category.Id">@category.ToIndentedName()</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Class="min-w-130" T="ProductSalesSort" @bind-Value="sort" Label="並び順" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
            @foreach (var value in Enum.GetValues<ProductSalesSort>())
            {
                <MudSelectItem T="ProductSalesSort" Value="value">@value.ToDisplayName()</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">集計</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="ProductSalesView" Items="rows" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh>商品</MudTh>
        <MudTh>部門</MudTh>
        <MudTh Class="text-right">販売数量</MudTh>
        <MudTh Class="text-right">返品数量</MudTh>
        <MudTh Class="text-right">純数量</MudTh>
        <MudTh Class="text-right">純売上</MudTh>
        <MudTh Class="text-right">値引</MudTh>
        <MudTh Class="text-right">粗利</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@ViewHelper.RankText(rows.IndexOf(context) + 1)</MudTd>
        <MudTd>@context.ProductCode @context.ProductName</MudTd>
        <MudTd>@context.CategoryName</MudTd>
        <MudTd Class="text-right">@context.QuantitySold.ToQuantityText()</MudTd>
        <MudTd Class="text-right">@context.QuantityReturned.ToQuantityText()</MudTd>
        <MudTd Class="text-right">@context.NetQuantity.ToQuantityText()</MudTd>
        <MudTd Class="text-right"><strong>@context.NetSales.ToYen()</strong></MudTd>
        <MudTd Class="text-right">@context.DiscountTotal.ToYen()</MudTd>
        <MudTd Class="text-right">@context.GrossProfit.ToYen()</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>期間内の売上がありません。</MudText>
    </NoRecordsContent>
</MudTable>
