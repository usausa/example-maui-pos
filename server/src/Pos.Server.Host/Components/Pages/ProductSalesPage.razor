@page "/reports/products"
@inherits PageComponentBase

<PageTitle>POS 管理 - 商品別売上</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">📈 商品別売上</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Size="Size.Small" Href="@CsvUrl" Disabled="IsBusy">CSV</MudButton>
</MudStack>

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudDateRangePicker @bind-DateRange="period" Label="期間 (営業日)" DateFormat="yyyy/MM/dd" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 260px;" />
        <StoreSelect Value="storeId" ValueChanged="OnStoreChanged" />
        <MudSelect T="Guid?" @bind-Value="categoryId" Label="部門" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 200px;">
            <MudSelectItem T="Guid?" Value="null">すべて</MudSelectItem>
            @foreach (var category in categories)
            {
                <MudSelectItem T="Guid?" Value="category.Id">@(category.ParentId is null ? string.Empty : "　")@category.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="sort" Label="並び順" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width: 130px;">
            <MudSelectItem T="string" Value="@("netSales")">純売上順</MudSelectItem>
            <MudSelectItem T="string" Value="@("quantity")">数量順</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">集計</MudButton>
    </MudStack>
</MudPaper>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="ProductSalesRow" Items="rows" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh>商品</MudTh>
        <MudTh>部門</MudTh>
        <MudTh Style="text-align: right;">販売数量</MudTh>
        <MudTh Style="text-align: right;">返品数量</MudTh>
        <MudTh Style="text-align: right;">純数量</MudTh>
        <MudTh Style="text-align: right;">純売上</MudTh>
        <MudTh Style="text-align: right;">値引</MudTh>
        <MudTh Style="text-align: right;">粗利</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@Rank(rows.IndexOf(context) + 1)</MudTd>
        <MudTd>@context.ProductCode @context.ProductName</MudTd>
        <MudTd>@context.CategoryName</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Quantity(context.QuantitySold)</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Quantity(context.QuantityReturned)</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Quantity(context.NetQuantity)</MudTd>
        <MudTd Style="text-align: right;"><strong>@DisplayText.Yen(context.NetSales)</strong></MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Yen(context.DiscountTotal)</MudTd>
        <MudTd Style="text-align: right;">@DisplayText.Yen(context.GrossProfit)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>期間内の売上がありません。</MudText>
    </NoRecordsContent>
</MudTable>
