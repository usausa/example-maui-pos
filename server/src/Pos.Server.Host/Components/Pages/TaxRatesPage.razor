@page "/tax-rates"
@inherits PageComponentBase

<PageTitle>POS 管理 - 税率</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">🏷️ 税率</MudText>
    <MudSpacer />
    <MudSwitch T="bool" @bind-Value="includeDeleted" @bind-Value:after="LoadAsync" Label="削除済みを表示" Color="Color.Primary" />
    <AuthorizeView Policy="@Policies.Administrator">
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="IsBusy" OnClick="AddAsync">追加</MudButton>
    </AuthorizeView>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="LoadAsync">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="TaxRateEntity" Items="items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="IsLoading">
    <HeaderContent>
        <MudTh>コード</MudTh>
        <MudTh>名称</MudTh>
        <MudTh Class="text-right">税率</MudTh>
        <MudTh>種別</MudTh>
        <MudTh>既定</MudTh>
        <MudTh Class="text-right">並び順</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@context.Name @ViewHelper.DeletedMark(context.IsDeleted)</MudTd>
        <MudTd Class="text-right">@context.Rate.ToPercentText()</MudTd>
        <MudTd>@context.Kind.ToDisplayName()</MudTd>
        <MudTd>@ViewHelper.DefaultMark(context.IsDefault)</MudTd>
        <MudTd Class="text-right">@context.SortOrder</MudTd>
        <MudTd Class="no-wrap">
            @if (!context.IsDeleted)
            {
                <AuthorizeView Policy="@Policies.Administrator" Context="auth">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsBusy" OnClick="() => EditAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="IsBusy" OnClick="() => DeleteAsync(context)" />
                </AuthorizeView>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>税率がありません。</MudText>
    </NoRecordsContent>
</MudTable>
