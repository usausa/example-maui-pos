@inherits EditDialogBase<TerminalForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudSelect T="Guid?" @bind-Value="Form.StoreId" For="@(() => Form.StoreId)" Validation="@Validator.ValidateValue" Label="店舗">
                        @foreach (var store in stores)
                        {
                            <MudSelectItem T="Guid?" Value="store.Id">@store.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Form.TerminalNo" For="@(() => Form.TerminalNo)" Validation="@Validator.ValidateValue" Label="端末番号" Min="1" Max="99" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名称" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
