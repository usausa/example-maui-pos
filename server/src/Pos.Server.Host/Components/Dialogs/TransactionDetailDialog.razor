<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">🧾 取引詳細</MudText>
            @if (transaction is not null)
            {
                <StatusChip Value="@ViewHelper.TypeChip(transaction.Type)" />
                <StatusChip Value="@ViewHelper.StatusChip(transaction.Status)" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@transaction.ReceiptNo</MudText>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (transaction is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td style="width: 110px;" class="mud-text-secondary">日時</td><td>@transaction.TransactedAt.ToDateTimeText() (営業日 @transaction.BusinessDate.ToDateText())</td></tr>
                            <tr><td class="mud-text-secondary">店舗 / 端末</td><td>@Names.Store(transaction.StoreId) / @Names.Terminal(transaction.TerminalId)</td></tr>
                            <tr><td class="mud-text-secondary">担当</td><td>@Names.StaffName(transaction.StaffId)</td></tr>
                            <tr><td class="mud-text-secondary">会員</td><td>@(customer is null ? "-" : customer.ToDisplayText())</td></tr>
                            <tr><td class="mud-text-secondary">備考</td><td>@transaction.Note</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td style="width: 110px;" class="mud-text-secondary">小計</td><td class="text-right">@transaction.Subtotal.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">値引</td><td class="text-right">-@transaction.DiscountTotal.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">合計 (内税 @transaction.TaxTotal.ToYen())</td><td class="text-right"><strong>@transaction.Total.ToYen()</strong></td></tr>
                            <tr><td class="mud-text-secondary">預り / 釣銭</td><td class="text-right">@transaction.TenderedTotal.ToYen() / @transaction.ChangeAmount.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">ポイント</td><td class="text-right">付与 @transaction.PointsEarned.ToPointText() / 利用 @transaction.PointsRedeemed.ToPointText()@(transaction.PointsBalanceAfter is null ? string.Empty : $" / 残高 {transaction.PointsBalanceAfter:N0}")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>

            @if (transaction.Status == TransactionStatus.Voided)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">❌ 取消済み: @transaction.VoidedAt.ToDateTimeText() @Names.StaffName(transaction.VoidedByStaffId) 「@transaction.VoidReason」</MudAlert>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2">明細</MudText>
            <MudSimpleTable Dense="true" Bordered="true" Striped="true" Elevation="0">
                <thead>
                    <tr><th>#</th><th>商品</th><th class="text-right">単価</th><th class="text-right">数量</th><th class="text-right">値引</th><th class="text-right">金額</th><th class="text-right">pt</th><th>シリアル</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr>
                            <td>@line.LineNo</td>
                            <td>@line.ProductCode @line.ProductName @ViewHelper.ReturnedText(line.ReturnedQuantity)</td>
                            <td class="text-right">@line.UnitPrice.ToYen()@ViewHelper.PriceOverrideMark(line.UnitPrice, line.ListPrice)</td>
                            <td class="text-right">@line.Quantity.ToQuantityText()</td>
                            <td class="text-right">@((line.DiscountAmount + line.AllocatedDiscountAmount).ToYen())</td>
                            <td class="text-right">@line.NetAmount.ToYen()</td>
                            <td class="text-right">@line.PointsEarned.ToPointText()</td>
                            <td>@ViewHelper.SerialNumbersText(serials.Where(x => x.TransactionLineId == line.Id).Select(x => x.SerialNumber))</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudGrid Spacing="2" Class="mt-1">
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">値引</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var discount in discounts)
                            {
                                <tr><td>@discount.Name @ViewHelper.TransactionDiscountMark(discount.LineId is null)</td><td class="text-right">-@discount.Amount.ToYen()</td></tr>
                            }
                            @if (discounts.Count == 0)
                            {
                                <tr><td class="mud-text-secondary">なし</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">税率別</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var tax in taxSummaries)
                            {
                                <tr><td>@tax.Rate.ToPercentText() @tax.TaxIncluded.ToTaxIncludedText()</td><td class="text-right">@tax.TaxableAmount.ToYen()</td><td class="text-right">税 @tax.TaxAmount.ToYen()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">支払</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var payment in payments)
                            {
                                <tr><td>@Names.PaymentMethod(payment.PaymentMethodId) @payment.Reference</td><td class="text-right">@payment.Amount.ToYen()</td><td class="text-right mud-text-secondary">預り @payment.TenderedAmount.ToYen()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>

            @if (delivery is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">🚚 配送先</MudText>
                <MudText Typo="Typo.body2">@delivery.RecipientName @delivery.Phone / @delivery.PostalCode @delivery.Address / @delivery.RequestedDate.ToDateText() @delivery.TimeSlot @delivery.Note</MudText>
            }

            @if (original is not null || returns.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">🔗 関連取引</MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    @if (original is not null)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenAsync(original.Id)">元取引 @original.ReceiptNo</MudChip>
                    }
                    @foreach (var item in returns)
                    {
                        <MudChip T="string" Color="@ViewHelper.RelatedTransactionColor(item.Status)" Size="Size.Small" OnClick="() => OpenAsync(item.Id)">返品 @item.ReceiptNo @(item.Status == TransactionStatus.Voided ? "(取消)" : string.Empty)</MudChip>
                    }
                </MudStack>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
