@inherits EditDialogBase<SupplierForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Code" For="@(() => Form.Code)" Validation="@Validator.ValidateValue" Label="コード" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名称" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.Phone" For="@(() => Form.Phone)" Validation="@Validator.ValidateValue" Label="電話" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.Email" For="@(() => Form.Email)" Validation="@Validator.ValidateValue" Label="メール" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Form.Note" For="@(() => Form.Note)" Validation="@Validator.ValidateValue" Label="備考" Lines="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効 (入荷の登録で選べる)" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
