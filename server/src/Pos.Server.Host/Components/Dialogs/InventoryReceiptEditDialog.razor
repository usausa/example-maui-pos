<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">📦 @Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="editForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <StoreSelect @bind-Value="Form.StoreId" AllowAll="false" Label="入荷する店舗" Class="mt-2" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudSelect T="Guid?" @bind-Value="Form.SupplierId" For="@(() => Form.SupplierId)" Validation="@Validator.ValidateValue" Label="仕入先">
                        @foreach (var supplier in suppliers)
                        {
                            <MudSelectItem T="Guid?" Value="supplier.Id">@supplier.Code @supplier.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.SlipNo" For="@(() => Form.SlipNo)" Validation="@Validator.ValidateValue" Label="納品書番号" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="Form.ExpectedDate" Label="入荷予定日" DateFormat="yyyy/MM/dd" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Note" For="@(() => Form.Note)" Validation="@Validator.ValidateValue" Label="備考" />
                </MudItem>
            </MudGrid>
        </MudForm>
        <MudText Typo="Typo.subtitle2" Class="mt-4">明細</MudText>
        <MudSimpleTable Dense="true" Elevation="0">
            <thead>
                <tr><th>商品</th><th class="w-100">数量</th><th class="w-120">仕入単価</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var line in Form.Lines)
                {
                    <tr>
                        <td class="min-w-260">
                            <MudAutocomplete T="ProductEntity" Value="line.Product" ValueChanged="@(x => OnProductChanged(line, x))" SearchFunc="SearchProductsAsync" ToStringFunc="@(x => x is null ? string.Empty : $"{x.Code} {x.Name}")" ResetValueOnEmptyText="true" MinCharacters="1" Margin="Margin.Dense" />
                        </td>
                        <td><MudNumericField T="decimal" @bind-Value="line.Quantity" Min="0.01m" Margin="Margin.Dense" /></td>
                        <td><MudNumericField T="decimal?" @bind-Value="line.Cost" Min="0m" Margin="Margin.Dense" /></td>
                        <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => RemoveLine(line)" /></td>
                    </tr>
                }
                @if (Form.Lines.Count == 0)
                {
                    <tr><td class="mud-text-secondary">明細がありません。</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mt-1" OnClick="AddLine">明細を追加</MudButton>
        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">登録</MudButton>
    </DialogActions>
</MudDialog>
