@inherits EditDialogBase<StoreForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Code" For="@(() => Form.Code)" Validation="@Validator.ValidateValue" Label="コード" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名称" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.PostalCode" For="@(() => Form.PostalCode)" Validation="@Validator.ValidateValue" Label="郵便番号" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Address" For="@(() => Form.Address)" Validation="@Validator.ValidateValue" Label="住所" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.Phone" For="@(() => Form.Phone)" Validation="@Validator.ValidateValue" Label="電話" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.RegistrationNo" For="@(() => Form.RegistrationNo)" Validation="@Validator.ValidateValue" Label="登録番号 (インボイス)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Form.ReceiptHeader" For="@(() => Form.ReceiptHeader)" Validation="@Validator.ValidateValue" Label="レシート上部" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Form.ReceiptFooter" For="@(() => Form.ReceiptFooter)" Validation="@Validator.ValidateValue" Label="レシート下部" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.TimeZone" For="@(() => Form.TimeZone)" Validation="@Validator.ValidateValue" Label="タイムゾーン (IANA)" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
