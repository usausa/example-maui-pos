@inherits EditDialogBase<AccountPasswordForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Value="Form.Name" Label="ID" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.Password" For="@(() => Form.Password)" Validation="@Validator.ValidateValue" Label="新しいパスワード" InputType="InputType.Password" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.PasswordConfirm" For="@(() => Form.PasswordConfirm)" Validation="@Validator.ValidateValue" Label="新しいパスワード (確認)" InputType="InputType.Password" Immediate="true" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mt-2 d-block">変更すると、このユーザーのログイン中の画面はログアウトします。</MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">変更</MudButton>
    </DialogActions>
</MudDialog>
