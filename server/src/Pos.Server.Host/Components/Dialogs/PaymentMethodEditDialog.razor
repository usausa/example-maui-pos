@inherits EditDialogBase<PaymentMethodForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Code" For="@(() => Form.Code)" Validation="@Validator.ValidateValue" Label="コード" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名称" Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Form.ShortName" For="@(() => Form.ShortName)" Validation="@Validator.ValidateValue" Label="ボタン名 (端末の会計画面。省略時は名称)" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="PaymentKind" @bind-Value="Form.Kind" Label="種別">
                        @foreach (var kind in Enum.GetValues<PaymentKind>())
                        {
                            <MudSelectItem T="PaymentKind" Value="kind">@DisplayText.Name(kind)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" @bind-Value="Form.SortOrder" Label="並び順" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.AllowsChange" Label="釣銭あり" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.RequiresReference" Label="伝票番号など必須" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
