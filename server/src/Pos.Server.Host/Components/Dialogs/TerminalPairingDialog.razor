<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">📱 端末の登録: @StoreName @Terminal.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">端末の初期設定で QR を読み取るか、サーバの URL とペアリングコードを入力してください。</MudText>
        <MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Class="pairing-code">@Code.Code</MudText>
            <MudText Typo="Typo.caption">有効期限 @Code.ExpiresAt.ToShortDateTimeText() (一度だけ使えます)</MudText>
            <MudPaper Outlined="true" Class="pa-4 d-inline-block">
                <img src="@qrImage" alt="設定 QR コード" width="240" height="240" />
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-2 mud-width-full">
                <pre class="qr-text">@qrText</pre>
            </MudPaper>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">登録すると、この端末の前の登録は使えなくなります。</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
