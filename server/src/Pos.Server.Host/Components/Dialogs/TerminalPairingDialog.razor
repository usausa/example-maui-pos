<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">📱 端末の登録: @StoreName @Terminal.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h3" Class="pairing-code">@Code.Code</MudText>
            <MudText Typo="Typo.caption">有効期限 @Code.ExpiresAt.ToShortDateTimeText() (一度だけ使えます)</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">登録すると前の登録は使えなくなります</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
