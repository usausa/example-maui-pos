<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">💰 精算レポート</MudText>
            @if (summary is not null)
            {
                <StatusChip Value="@ViewHelper.StatusChip(summary.Shift.Shift.Status)" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Names.Store(summary.Shift.Shift.StoreId) / @Names.Terminal(summary.Shift.Shift.TerminalId) / @summary.Shift.Shift.BusinessDate.ToDateText()</MudText>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (summary is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">💴 現金</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td class="mud-text-secondary" style="width: 120px;">開設 / 精算</td><td>@summary.Shift.Shift.OpenedAt.ToDateTimeText() @Names.StaffName(summary.Shift.Shift.OpenedByStaffId) / @summary.Shift.Shift.ClosedAt.ToDateTimeText() @Names.StaffName(summary.Shift.Shift.ClosedByStaffId)</td></tr>
                            <tr><td class="mud-text-secondary">釣銭準備金</td><td class="text-right">@summary.Shift.Shift.OpeningCash.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">現金売上 / 返金</td><td class="text-right">@summary.Shift.Totals.CashSales.ToYen() / -@summary.Shift.Totals.CashReturns.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">入金 / 出金</td><td class="text-right">@summary.Shift.Totals.PaidIn.ToYen() / -@summary.Shift.Totals.PaidOut.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">予想現金</td><td class="text-right"><strong>@summary.Shift.ExpectedCash.ToYen()</strong></td></tr>
                            <tr><td class="mud-text-secondary">実査</td><td class="text-right">@summary.Shift.Shift.ActualCash.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">過不足</td><td class="text-right"><StatusChip Value="@ViewHelper.DifferenceChip(summary.Shift.Shift.Difference)" /></td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">📈 件数・売上</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td class="mud-text-secondary" style="width: 120px;">販売 / 返品 / 取消</td><td class="text-right">@summary.Shift.Totals.SalesCount / @summary.Shift.Totals.ReturnCount / @summary.Shift.Totals.VoidCount 件</td></tr>
                            <tr><td class="mud-text-secondary">売上 / 返品</td><td class="text-right">@summary.Shift.Totals.SalesTotal.ToYen() / -@summary.Shift.Totals.ReturnsTotal.ToYen()</td></tr>
                            <tr><td class="mud-text-secondary">ポイント</td><td class="text-right">付与 @summary.Points.Earned.ToPointText() / 利用 @summary.Points.Redeemed.ToPointText()</td></tr>
                            <tr><td class="mud-text-secondary">備考</td><td>@summary.Shift.Shift.Note</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">支払方法別</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var item in summary.ByPaymentMethod)
                            {
                                <tr><td>@item.Name</td><td class="text-right">@item.SalesAmount.ToYen() (@item.SalesCount)</td><td class="text-right mud-text-secondary">返金 @item.ReturnAmount.ToYen()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">税率別</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var item in summary.ByTaxRate)
                            {
                                <tr><td>@item.Rate.ToPercentText() @item.TaxIncluded.ToTaxIncludedText()</td><td class="text-right">@item.TaxableAmount.ToYen()</td><td class="text-right mud-text-secondary">税 @item.TaxAmount.ToYen()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">部門別</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var item in summary.ByCategory)
                            {
                                <tr><td>@item.Name</td><td class="text-right">@item.Quantity.ToQuantityText()</td><td class="text-right">@item.NetAmount.ToYen()</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">入出金</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var item in cashEvents)
                            {
                                <tr><td>@item.OccurredAt.ToTimeText()</td><td><StatusChip Value="@ViewHelper.CashEventChip(item.Type)" /></td><td class="text-right">@item.Amount.ToYen()</td><td>@item.Reason</td><td>@Names.StaffName(item.StaffId)</td></tr>
                            }
                            @if (cashEvents.Count == 0)
                            {
                                <tr><td class="mud-text-secondary">なし</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">金種</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var item in summary.Shift.Denominations)
                            {
                                <tr><td>@item.Denomination.ToYen() 円</td><td class="text-right">@item.Count 枚</td><td class="text-right">@((item.Denomination * item.Count).ToYen())</td></tr>
                            }
                            @if (summary.Shift.Denominations.Count == 0)
                            {
                                <tr><td class="mud-text-secondary">なし</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Receipt" Href="@($"transactions?shiftId={Id}")" OnClick="() => MudDialog.Close()">取引一覧</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Href="@ExportUrls.ShiftSummaryPdf(Id)" Target="_blank">精算レポート PDF</MudButton>
        <MudButton Color="Color.Primary" OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
