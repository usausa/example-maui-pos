@inherits EditDialogBase<PointAdjustForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Form.Points" For="@(() => Form.Points)" Validation="@Validator.ValidateValue" Label="増減 (pt)" HelperText="減らすときは負の値" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudSelect T="Guid?" @bind-Value="Form.StaffId" For="@(() => Form.StaffId)" Validation="@Validator.ValidateValue" Label="担当">
                        @foreach (var staff in staffList)
                        {
                            <MudSelectItem T="Guid?" Value="staff.Id">@staff.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Form.Reason" For="@(() => Form.Reason)" Validation="@Validator.ValidateValue" Label="理由" Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">登録</MudButton>
    </DialogActions>
</MudDialog>
