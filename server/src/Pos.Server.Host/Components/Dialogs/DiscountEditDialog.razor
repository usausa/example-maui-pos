@inherits EditDialogBase<DiscountForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Code" For="@(() => Form.Code)" Validation="@Validator.ValidateValue" Label="コード" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名称" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="DiscountType" @bind-Value="Form.Type" Label="種別">
                        @foreach (var type in Enum.GetValues<DiscountType>())
                        {
                            <MudSelectItem T="DiscountType" Value="type">@DisplayText.Name(type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="Form.Value" For="@(() => Form.Value)" Validation="@Validator.ValidateValue" Label="@(Form.Type == DiscountType.Percent ? "率 (0.05 = 5%)" : "金額")" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="DiscountScope" @bind-Value="Form.Scope" Label="適用範囲">
                        @foreach (var scope in Enum.GetValues<DiscountScope>())
                        {
                            <MudSelectItem T="DiscountScope" Value="scope">@DisplayText.Name(scope)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int" @bind-Value="Form.SortOrder" Label="並び順" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.RequiresApproval" Label="承認要" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
