@inherits EditDialogBase<StaffForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Form.Code" For="@(() => Form.Code)" Validation="@Validator.ValidateValue" Label="コード" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="名前" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="StaffRole" @bind-Value="Form.Role" Label="役割">
                        @foreach (var role in Enum.GetValues<StaffRole>())
                        {
                            <MudSelectItem T="StaffRole" Value="role">@DisplayText.Name(role)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="Guid?" @bind-Value="Form.StoreId" Label="所属店舗">
                        <MudSelectItem T="Guid?" Value="null">全店舗</MudSelectItem>
                        @foreach (var store in stores)
                        {
                            <MudSelectItem T="Guid?" Value="store.Id">@store.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSwitch T="bool" @bind-Value="Form.IsActive" Label="有効" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
