@inherits EditDialogBase<StaffPinForm>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="EditForm" Model="Form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Value="Form.Name" Label="名前" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.Pin" For="@(() => Form.Pin)" Validation="@Validator.ValidateValue" Label="PIN" InputType="InputType.Password" MaxLength="@Length.PinDigits" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Form.PinConfirm" For="@(() => Form.PinConfirm)" Validation="@Validator.ValidateValue" Label="PIN (確認)" InputType="InputType.Password" MaxLength="@Length.PinDigits" Immediate="true" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mt-2 d-block">端末のログインと承認に使います。端末には次の同期で届きます。</MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">設定</MudButton>
    </DialogActions>
</MudDialog>
